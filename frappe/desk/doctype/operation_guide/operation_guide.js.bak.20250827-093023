    generateEnhancedPrintContent(options) {
        let html = '';
        
        // Header
        html += `
            <div class="print-header">
                <h1>${this.frm.doc.operation_guide_title || 'Operation Guide'}</h1>
                <div class="header-meta">
                    <span>Generated: ${new Date().toLocaleDateString()}</span>
                    <span>${this.blocks.length} blocks</span>
                </div>
            </div>
        `;
        
        // Table of Contents
        if (options.table_of_contents) {
            html += this.generateTableOfContents();
        }
        
        // Blocks
        html += '<div class="print-content">';
        
        this.blocks.forEach((block, index) => {
            html += this.generatePrintBlock(block, index, options);
        });
        
        html += '</div>';
        
        // Footer
        if (options.page_numbers) {
            html += `
                <div class="print-footer">
                    <span class="page-number"></span>
                </div>
            `;
        }
        
        return html;
    }

    generateTableOfContents() {
        let html = '<div class="table-of-contents">';
        html += '<h2>Table of Contents</h2>';
        html += '<ol>';
        
        this.blocks.forEach((block, index) => {
            const blockType = this.getBlockType(block);
            if (blockType === 'Header' || blockType === 'Title') {
                const content = block.header || block.title;
                html += `<li><a href="#block-${index}">${this.sanitizeContent(content)}</a></li>`;
            }
        });
        
        html += '</ol></div>';
        return html;
    }

    generatePrintBlock(block, index, options) {
        let html = `<div class="print-block" id="block-${index}">`;
        
        // Block content
        html += this.renderBlockContent(block, index);
        
        // Description
        if (options.include_descriptions && block.description) {
            html += `
                <div class="print-description">
                    ${this.sanitizeContent(block.description)}
                </div>
            `;
        }
        
        // Timestamp
        if (options.include_timestamps) {
            html += `
                <div class="print-timestamp">
                    Last modified: ${new Date(block.modified).toLocaleString()}
                </div>
            `;
        }
        
        html += '</div>';
        return html;
    }

