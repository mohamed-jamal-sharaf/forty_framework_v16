                        class="floating-add-btn" 
                        title="Add Block (Ctrl+N)">
                    <i class="fa fa-plus"></i>
                </button>
            </div>
        `);

        this.addStyles();
        this.bindEvents();
    }

    bindEvents() {
        // Add block button
        document.getElementById('floating_add_btn').addEventListener('click', this.handleAddBlock);
        document.querySelector('.add-first-block')?.addEventListener('click', this.handleAddBlock);
        
        // Search
        document.getElementById('block_search').addEventListener('input', this.handleSearch);
        
        // Toolbar buttons
        document.getElementById('save_all').addEventListener('click', () => this.saveAll());
        document.getElementById('export_pdf').addEventListener('click', () => this.exportToPDF());
        document.getElementById('toggle_page_breaks').addEventListener('click', () => this.togglePageBreaks());
        document.getElementById('undo_btn').addEventListener('click', () => this.undo());
        document.getElementById('redo_btn').addEventListener('click', () => this.redo());
        document.getElementById('shortcuts_btn').addEventListener('click', () => this.showShortcutsHelp());
    }

    // Additional methods remain the same as in original code...
    togglePageBreaks() {
        this.showPageBreaks = !this.showPageBreaks;
        const toggleBtn = document.getElementById('toggle_page_breaks');
        const container = document.getElementById('operation_guide_ui');
        
        if (this.showPageBreaks) {
            toggleBtn.innerHTML = '<i class="fa fa-file-text-o"></i> Hide Breaks';
            toggleBtn.classList.add('btn-warning');
            toggleBtn.classList.remove('btn-outline-secondary');
            container.classList.add('pdf-preview-mode');
            this.addPageBreakIndicators();
            frappe.show_alert('📄 A4 page breaks are now visible', 'blue');
        } else {
            toggleBtn.innerHTML = '<i class="fa fa-file-text-o"></i> Page Breaks';
            toggleBtn.classList.remove('btn-warning');
            toggleBtn.classList.add('btn-outline-secondary');
            container.classList.remove('pdf-preview-mode');
            this.removePageBreakIndicators();
            frappe.show_alert('📄 Page breaks hidden', 'blue');
        }
    }

    addPageBreakIndicators() {
        // Remove existing page breaks first
        this.removePageBreakIndicators();
        
        const blocksContainer = document.getElementById('operation_blocks_wrapper');
        if (!blocksContainer) return;
        
        const blocks = blocksContainer.querySelectorAll('.operation-block');
        if (blocks.length === 0) return;
        
        let currentPageHeight = 100; // Start with some margin
        let pageNumber = 1;
        
        blocks.forEach((block, index) => {
            // Get block height (including margins)
            const blockRect = block.getBoundingClientRect();
            const blockHeight = blockRect.height + 40; // Add margin
            
            // Check if block would overflow current page
            if (currentPageHeight + blockHeight > this.A4_HEIGHT && index > 0) {
                // Insert page break before this block
                const pageBreak = document.createElement('div');
                pageBreak.className = 'page-break-line';
                pageBreak.innerHTML = `<span style="position: absolute; top: -25px; right: 50px; background: #28a745; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px;">Page ${pageNumber + 1}</span>`;
                
                block.parentNode.insertBefore(pageBreak, block);
                
                // Reset height for new page
                currentPageHeight = 100 + blockHeight;
                pageNumber++;
            } else {
                currentPageHeight += blockHeight;
            }
        });
        
        // Add final page indicator
        const finalIndicator = document.createElement('div');
        finalIndicator.className = 'page-end-indicator';
        finalIndicator.innerHTML = `
            <div style="text-align: center; margin: 20px 0; padding: 15px; background: #e9ecef; border-radius: 8px; color: #495057;">
                📄 End of Page ${pageNumber} • Total: ${pageNumber} page${pageNumber > 1 ? 's' : ''}
            </div>
        `;
        blocksContainer.appendChild(finalIndicator);
    }

    removePageBreakIndicators() {
        document.querySelectorAll('.page-break-line, .page-end-indicator').forEach(el => {
            el.remove();
        });
    }

    toggleEmptyState(show) {
        const emptyState = document.getElementById('empty_state');
        const blocksWrapper = document.getElementById('operation_blocks_wrapper');
        
        if (show && this.blocks.length === 0) {
            emptyState.style.display = 'block';
            blocksWrapper.style.display = 'none';
        } else {
            emptyState.style.display = 'none';
            blocksWrapper.style.display = 'block';
        }
    }

    async loadExistingBlocks() {
        try {
            const response = await frappe.call({
                method: "frappe.client.get_list",
                args: {
                    doctype: "Operation Guide DATA",
                    filters: { operation_guide_title: this.frm.doc.operation_guide_title },
                    fields: ["*"],
                    order_by: "modified desc"  // Most recently modified appears first
                }
            });
            
            if (response.message) {
                this.blocks = response.message;
                this.renderBlocks();
                this.toggleEmptyState(this.blocks.length === 0);
                console.log('Loaded blocks:', this.blocks.length);
                
                // Check for draft
                if (this.blocks.length === 0) {
                    this.loadDraft();
                }
            }
        } catch (error) {
            await this.handleError(error, 'loadExistingBlocks');
        }
    }

    renderBlocks() {
        const wrapper = document.getElementById('operation_blocks_wrapper');
        if (!wrapper) return;

        // Clean up previous block data references
        this.cleanupBlockData();

        let html = "";
        
        this.blocks.forEach((block, index) => {
            const blockType = this.getBlockType(block);
            
            // Store block data in a more accessible way
            const blockDataId = `block_data_${block.name}`;
            window[blockDataId] = block;
            
            // Determine if copy button should be shown and what it should do
            const isCopyable = !['Photo', 'Attachment'].includes(blockType);
            const copyButton = isCopyable 
                ? `<button onclick="window.copyOperationBlockContent('${block.name}')" 
                          title="Copy Content">
                       <i class="fa fa-copy"></i>
                   </button>`
                : `<button onclick="window.duplicateOperationBlock('${block.name}')" 
                          title="Duplicate Block">
                       <i class="fa fa-clone"></i>
                   </button>`;
            
            html += `
                <div class="operation-block fade-in" 
                     data-block-id="${block.name}" 
                     data-block-type="${blockType}"
                     data-block-index="${index}"
                     draggable="true"
                     title="Drag to reorder">
                    <div class="block-controls-overlay">
                        ${copyButton}
                        <button onclick="window.editOperationBlock('${block.name}')" 
                                title="Edit">
                            <i class="fa fa-edit"></i>
                        </button>
                        <button onclick="window.deleteOperationBlock('${block.name}', '${blockType}')" 
                                title="Delete">
                            <i class="fa fa-trash"></i>
                        </button>
                    </div>
                    <div class="block-content-direct">
                        ${this.renderBlockContent(block, index)}
                        ${block.description ? `<div class="block-description" style="margin-top: 15px; padding: 10px; background: #f8f9fa; border-left: 4px solid #dee2e6; font-style: italic; color: #6c757d; border-radius: 4px; font-size: 14px;">${this.sanitizeContent(block.description)}</div>` : ''}
                    </div>
                </div>
            `;
        });

        wrapper.innerHTML = html;
        
        // Initialize drag and drop after rendering
        this.initializeDragAndDrop();
        
        // Add page breaks if enabled
        if (this.showPageBreaks) {
            this.addPageBreakIndicators();
        }
    }

    cleanupBlockData() {
        // Remove previous block data references from window object
        for (let prop in window) {
            if (prop.startsWith('block_data_')) {
                delete window[prop];
            }
        }
    }

    getBlockType(block) {
        const typeMap = {
            header: "Header",
            title: "Title", 
            list: "List",
            text: "Text",
            js_code: "JS Code",
            python_code: "Python Code",
            photo: "Photo",
            attachment: "Attachment",
            link: "Link"
        };
        
        for (const [key, type] of Object.entries(typeMap)) {
            if (block[key]) return type;
        }
        return "Unknown";
    }

    handleAddBlock() {
        this.showBlockTypePopup();
    }

    openBlockInputDialog(type, docname = null, currentValue = "") {
        const fieldMap = {
            "Header": { fieldtype: "Data", label: "Header Text", icon: "📑" },
            "Title": { fieldtype: "Data", label: "Title Text", icon: "📌" },
            "List": { fieldtype: "Text", label: "List Items (one per line)", icon: "📋" },
            "Text": { fieldtype: "Small Text", label: "Paragraph Text", icon: "📝" },
            "JS Code": { fieldtype: "Code", label: "JavaScript Code", options: "JS", icon: "🟨" },
            "Python Code": { fieldtype: "Code", label: "Python Code", options: "Py", icon: "🐍" },
            "Photo": { fieldtype: "Attach Image", label: "Upload Image", icon: "📷" },
            "Attachment": { fieldtype: "Attach", label: "Upload File", icon: "📎" },
            "Link": { fieldtype: "Data", label: "URL", icon: "🔗" }
        };

        const config = fieldMap[type];
        const fieldKey = type.toLowerCase().replace(" ", "_");

        const fields = [
            {
                label: config.label,
                fieldname: fieldKey,
                fieldtype: config.fieldtype,
                options: config.options || "",
                reqd: 1,
                default: currentValue
            }
        ];

        // Add description field for all blocks
        if (type !== "Photo" && type !== "Attachment") {
            // Get current description if editing
            let currentDescription = "";
            if (docname) {
                const blockDataId = `block_data_${docname}`;
                const blockData = window[blockDataId];
                if (blockData && blockData.description) {
                    currentDescription = blockData.description;
                }
            }
            
            fields.push({
                label: "Description (Optional)",
                fieldname: "description",
                fieldtype: "Small Text",
                description: "Brief description of this block",
                default: currentDescription
            });
        }

        frappe.prompt(fields, async (values) => {
            try {
                values.operation_guide_title = this.frm.doc.operation_guide_title;
                
                if (docname) {
                    // Track edit for undo
                    const oldValue = currentValue;
                    const newValue = values[fieldKey];
                    
                    await this.updateBlock(docname, fieldKey, values);
                    
                    this.pushToUndoStack({
                        type: 'edit',
                        blockId: docname,
                        fieldKey: fieldKey,
                        oldValue: oldValue,
                        newValue: newValue
                    });
                } else {
                    await this.createBlock(fieldKey, values, type);
                }
                
                frappe.show_alert(`${config.icon} "${type}" block ${docname ? 'updated' : 'added'} successfully!`, 'green');
                this.loadExistingBlocks();
            } catch (error) {
                await this.handleError(error, 'openBlockInputDialog');
            }
        }, `${config.icon} ${docname ? "Edit" : "Add"} ${type}`);
    }

    async updateBlock(docname, fieldKey, values) {
        return new Promise((resolve, reject) => {
            frappe.call({
                method: "frappe.client.set_value",
                args: {
                    doctype: "Operation Guide DATA",
                    name: docname,
                    fieldname: {
                        [fieldKey]: values[fieldKey],
                        description: values.description || ''
                    }
                },
                callback: (r) => {
                    if (r.exc) {
                        reject(r.exc);
                    } else {
                        resolve(r.message);
                    }
                }
            });
        });
    }

    async deleteBlock(docname, blockType, trackUndo = true) {
        const confirmDelete = await this.showConfirmDialog(
            `Delete ${blockType} Block`,
            `Are you sure you want to delete this ${blockType.toLowerCase()} block? This action cannot be undone.`
        );
        
        if (!confirmDelete) return;

        try {
            // Get block data for undo
            const blockData = this.blocks.find(b => b.name === docname);
            
            await new Promise((resolve, reject) => {
                frappe.call({
                    method: "frappe.client.delete",
                    args: {
                        doctype: "Operation Guide DATA",
                        name: docname
                    },
                    callback: (r) => {
                        if (r.exc) {
                            reject(r.exc);
                        } else {
                            resolve(r.message);
                        }
                    }
                });
            });
            
            if (trackUndo && blockData) {
                this.pushToUndoStack({
                    type: 'delete',
                    blockId: docname,
                    blockType: blockType,
                    blockData: blockData
                });
            }
            
            frappe.show_alert('Block deleted successfully', 'green');
            this.loadExistingBlocks();
        } catch (error) {
            await this.handleError(error, 'deleteBlock');
        }
    }

    async restoreBlock(blockData) {
        try {
            const newBlock = { ...blockData };
            delete newBlock.name;
            delete newBlock.creation;
            delete newBlock.modified;
            
            await new Promise((resolve, reject) => {
                frappe.call({
                    method: "frappe.client.insert",
                    args: { 
                        doc: { 
                            ...newBlock, 
                            doctype: "Operation Guide DATA" 
                        } 
                    },
                    callback: (r) => r.exc ? reject(r.exc) : resolve(r.message)
                });
            });
            
            await this.loadExistingBlocks();
        } catch (error) {
            await this.handleError(error, 'restoreBlock');
        }
    }

    showConfirmDialog(title, message) {
        return new Promise((resolve) => {
            const dialog = new frappe.ui.Dialog({
                title: title,
                fields: [
                    {
                        fieldtype: "HTML",
                        options: `<p>${message}</p>`
                    }
                ],
                primary_action_label: "Delete",
                primary_action: () => {
                    dialog.hide();
                    resolve(true);
                },
                secondary_action_label: "Cancel",
                secondary_action: () => {
                    dialog.hide();
                    resolve(false);
                }
            });
            dialog.show();
        });
    }

    editBlock(docname, blockData) {
        const typeMap = {
            "header": "Header",
            "title": "Title",
            "list": "List", 
            "text": "Text",
            "js_code": "JS Code",
            "python_code": "Python Code",
            "photo": "Photo",
            "attachment": "Attachment",
            "link": "Link"
        };
        
        for (const [key, type] of Object.entries(typeMap)) {
            if (blockData[key] && blockData[key].trim()) {
                this.openBlockInputDialog(type, docname, blockData[key]);
                return;
            }
        }
        
        // Fallback - if no content found, show error
        frappe.show_alert('No content found in this block', 'orange');
    }

    async duplicateBlock(docname) {
        try {
            const blockData = this.blocks.find(b => b.name === docname);
            if (!blockData) return;
            
            const newBlock = { ...blockData };
            delete newBlock.name;
            delete newBlock.creation;
            delete newBlock.modified;
            
            await new Promise((resolve, reject) => {
                frappe.call({
                    method: "frappe.client.insert",
                    args: { doc: { ...newBlock, doctype: "Operation Guide DATA" } },
                    callback: (r) => r.exc ? reject(r.exc) : resolve(r.message)
                });
            });
            
            frappe.show_alert('Block duplicated successfully', 'green');
            this.loadExistingBlocks();
        } catch (error) {
            await this.handleError(error, 'duplicateBlock');
        }
    }

    async reorderBlocksByDrop(draggedId, targetId) {
        console.log('=== REORDERING BLOCKS ===');
        console.log('Moving:', draggedId, 'to position of:', targetId);
        
        try {
            // Track for undo
            this.pushToUndoStack({
                type: 'reorder',
                fromId: draggedId,
                toId: targetId
            });
            
            // Simple approach: update the dragged block timestamp to be newer
            const now = new Date();
            const newTimestamp = new Date(now.getTime() + Math.random() * 1000).toISOString();
            
            console.log('Updating timestamp for block:', draggedId);
            
            // Trigger an update to change the modified timestamp
            await new Promise((resolve, reject) => {
                frappe.call({
                    method: "frappe.client.set_value",
                    args: {
                        doctype: "Operation Guide DATA",
                        name: draggedId,
                        fieldname: "description",
                        value: (window[`block_data_${draggedId}`]?.description || '') + ' ' // Add space to trigger update
                    },
                    callback: (r) => {
                        if (r.exc) {
                            console.error('Error updating block:', r.exc);
                            reject(r.exc);
                        } else {
                            console.log('✅ Block updated successfully');
                            resolve(r.message);
                        }
                    }
                });
            });
            
            // Wait a moment then trim the description back
            await new Promise(resolve => setTimeout(resolve, 100));
            
            await new Promise((resolve, reject) => {
                frappe.call({
                    method: "frappe.client.set_value",
                    args: {
                        doctype: "Operation Guide DATA",
                        name: draggedId,
                        fieldname: "description",
                        value: (window[`block_data_${draggedId}`]?.description || '').trim()
                    },
                    callback: (r) => {
                        if (r.exc) {
                            console.error('Error cleaning description:', r.exc);
                            reject(r.exc);
                        } else {
                            console.log('✅ Description cleaned');
                            resolve(r.message);
                        }
                    }
                });
            });
            
            console.log('✅ Reordering complete, reloading blocks...');
            
            // Reload blocks after changes
            setTimeout(() => {
                this.loadExistingBlocks();
            }, 300);
            
        } catch (error) {
            await this.handleError(error, 'reorderBlocksByDrop');
        }
    }
}

