window.copyCodeBlock = async function(blockId) {
    const codeBlock = document.getElementById(blockId);
    if (!codeBlock) return;
    
    const fullCode = atob(codeBlock.dataset.fullCode || '');
    const code = fullCode || codeBlock.querySelector('.code-content').textContent;
    
    try {
        await navigator.clipboard.writeText(code);
        frappe.show_alert('📋 Code copied to clipboard!', 'green');
    } catch (err) {
        console.error('Failed to copy code:', err);
        frappe.show_alert('Failed to copy code', 'red');
    }
};

window.toggleCodeExpansion = function(blockId) {
    const codeBlock = document.getElementById(blockId);
    if (!codeBlock) return;
    
    const isExpanded = codeBlock.dataset.expanded === 'true';
    const fullCode = atob(codeBlock.dataset.fullCode || '');
    
    if (!fullCode) return;
    
    const lines = fullCode.split('\n');
    const tbody = codeBlock.querySelector('.code-table tbody');
    
    if (!isExpanded) {
        // Expand
        let html = '';
        lines.forEach((line, i) => {
            html += `
                <tr>
                    <td class="line-number">${i + 1}</td>
                    <td class="line-content"><pre>${window.operationGuide.sanitizeContent(line)}</pre></td>
                </tr>
            `;
        });
        tbody.innerHTML = html;
        codeBlock.dataset.expanded = 'true';
        codeBlock.querySelector('.fa-expand').className = 'fa fa-compress';
    } else {
        // Collapse
        window.operationGuide.renderEnhancedCodeBlock(fullCode, codeBlock.dataset.language, blockId);
    }
};

window.rotatePhoto = function(photoId, degrees) {
    const photo = document.getElementById(photoId);
    if (!photo) return;
    
    const currentRotation = parseInt(photo.dataset.rotation || '0');
    const newRotation = currentRotation + degrees;
    
    photo.style.transform = `rotate(${newRotation}deg) scale(${photo.dataset.currentScale || 1})`;
    photo.dataset.rotation = newRotation;
    
    frappe.show_alert(`🔄 Rotated ${degrees > 0 ? 'right' : 'left'}`, 'blue');
};

window.resetPhoto = function(photoId) {
    const photo = document.getElementById(photoId);
    const zoomInfo = document.getElementById(`${photoId}_zoom`);
    
    if (photo) {
        photo.style.transform = 'rotate(0deg) scale(1)';
        photo.dataset.rotation = '0';
        photo.dataset.currentScale = '1';
        if (zoomInfo) zoomInfo.textContent = '100%';
        
        frappe.show_alert('↺ Photo reset', 'blue');
    }
};

window.downloadPhoto = async function(photoId) {
    const photo = document.getElementById(photoId);
    if (!photo) return;
    
    try {
        const response = await fetch(photo.src);
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        
        const a = document.createElement('a');
        a.href = url;
        a.download = `operation-guide-photo-${photoId}.${blob.type.split('/')[1]}`;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
        
        frappe.show_alert('📥 Photo download started', 'green');
    } catch (error) {
        console.error('Download failed:', error);
        frappe.show_alert('Failed to download photo', 'red');
    }
};

window.onPhotoLoad = function(photoId) {
    const photo = document.getElementById(photoId);
    const dimensionsEl = document.getElementById(`${photoId}_dimensions`);
    const filesizeEl = document.getElementById(`${photoId}_filesize`);
    const loadingEl = photo.parentElement.querySelector('.photo-loading');
    
    if (photo) {
        // Hide loading indicator
        if (loadingEl) loadingEl.style.display = 'none';
        
        // Add loaded class for animation
        photo.classList.add('loaded');
        
        // Update dimensions
        if (dimensionsEl) {
            dimensionsEl.textContent = `${photo.naturalWidth} × ${photo.naturalHeight}px`;
        }
        
        // Estimate file size (rough estimate)
        if (filesizeEl) {
            const estimatedSize = (photo.naturalWidth * photo.naturalHeight * 3) / 1024 / 1024;
            filesizeEl.textContent = `~${estimatedSize.toFixed(1)}MB`;
        }
    }
};

