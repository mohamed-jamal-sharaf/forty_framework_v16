    // Method to handle block creation
    async createBlock(fieldKey, values, type, trackUndo = true) {
        try {
            const result = await new Promise((resolve, reject) => {
                frappe.call({
                    method: "frappe.client.insert",
                    args: {
                        doc: {
                            doctype: "Operation Guide DATA",
                            operation_guide_title: values.operation_guide_title,
                            block_type: type,
                            [fieldKey]: values[fieldKey],
                            description: values.description || ''
                        }
                    },
                    callback: (r) => {
                        if (r.exc) {
                            reject(new Error(r.exc));
                        } else {
                            resolve(r.message);
                        }
                    }
                });
            });
            
            if (trackUndo) {
                this.pushToUndoStack({
                    type: 'add',
                    blockId: result.name,
                    blockType: type,
                    blockData: result
                });
            }
            
            return result;
        } catch (error) {
            await this.handleError(error, 'createBlock');
            throw error;
        }
    }

