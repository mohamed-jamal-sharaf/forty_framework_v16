    async showTemplateSelector() {
        let html = `<div class="template-grid">`;
        
        Object.entries(this.blockTemplates).forEach(([key, template]) => {
            html += `
                <div class="template-option" data-template="${key}">
                    <h5>${template.name}</h5>
                    <p>${template.blocks.length} blocks</p>
                </div>
            `;
        });
        
        html += `</div>`;
        
        const dialog = new frappe.ui.Dialog({
            title: "📄 Choose Template",
            fields: [{ fieldname: "templates", fieldtype: "HTML", options: html }]
        });
        
        dialog.show();
        
        $(dialog.$wrapper)
            .find('.template-option')
            .on('click', async (e) => {
                const templateKey = $(e.currentTarget).data("template");
                const template = this.blockTemplates[templateKey];
                dialog.hide();
                
                await this.applyTemplate(template);
            });
    }

    async applyTemplate(template) {
        frappe.show_alert('Applying template...', 'blue');
        
        for (const blockDef of template.blocks) {
            const fieldKey = blockDef.type.toLowerCase().replace(" ", "_");
            await this.createBlock(fieldKey, {
                [fieldKey]: blockDef.content,
                operation_guide_title: this.frm.doc.operation_guide_title
            }, blockDef.type, false);
        }
        
        await this.loadExistingBlocks();
        frappe.show_alert(`Template "${template.name}" applied!`, 'green');
    }

    // Enhanced drag and drop with visual feedback
    initializeDragAndDrop() {
        const container = document.getElementById('operation_blocks_wrapper');
        if (!container) return;

        // Setup Intersection Observer for lazy loading
        this.setupIntersectionObserver();

        // Use event delegation for better performance
        container.addEventListener('dragstart', this.handleDragStart);
        container.addEventListener('dragend', this.handleDragEnd);
        container.addEventListener('dragover', this.handleDragOver);
        container.addEventListener('dragenter', this.handleDragEnter);
        container.addEventListener('dragleave', this.handleDragLeave);
        container.addEventListener('drop', this.handleDrop);

        // Touch support
        this.addTouchSupport();
    }

    setupIntersectionObserver() {
        const observerOptions = {
            root: null,
            rootMargin: '50px',
            threshold: 0.01
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const img = entry.target;
                    if (img.dataset.src) {
                        img.src = img.dataset.src;
                        img.removeAttribute('data-src');
                        observer.unobserve(img);
                    }
                }
            });
        }, observerOptions);

        // Observe all images with data-src
        document.querySelectorAll('img[data-src]').forEach(img => {
            observer.observe(img);
        });

        this.observers.set('images', observer);
    }

    addTouchSupport() {
        let touchItem = null;
        let touchOffset = { x: 0, y: 0 };

        const container = document.getElementById('operation_blocks_wrapper');

        container.addEventListener('touchstart', (e) => {
            const block = e.target.closest('.operation-block');
            if (!block) return;

            touchItem = block;
            const touch = e.touches[0];
            const rect = block.getBoundingClientRect();
            touchOffset.x = touch.clientX - rect.left;
            touchOffset.y = touch.clientY - rect.top;

            block.style.opacity = '0.8';
            block.style.transition = 'none';
        });

        container.addEventListener('touchmove', (e) => {
            if (!touchItem) return;
            e.preventDefault();

            const touch = e.touches[0];
            touchItem.style.position = 'fixed';
            touchItem.style.zIndex = '1000';
            touchItem.style.left = `${touch.clientX - touchOffset.x}px`;
            touchItem.style.top = `${touch.clientY - touchOffset.y}px`;
            touchItem.style.pointerEvents = 'none';

            // Find drop target
            const dropTarget = document.elementFromPoint(touch.clientX, touch.clientY);
            const dropBlock = dropTarget?.closest('.operation-block');

            document.querySelectorAll('.operation-block').forEach(block => {
                block.classList.remove('drag-over');
            });

            if (dropBlock && dropBlock !== touchItem) {
                dropBlock.classList.add('drag-over');
            }
        });

        container.addEventListener('touchend', async (e) => {
            if (!touchItem) return;

            const touch = e.changedTouches[0];
            const dropTarget = document.elementFromPoint(touch.clientX, touch.clientY);
            const dropBlock = dropTarget?.closest('.operation-block');

            if (dropBlock && dropBlock !== touchItem) {
                await this.reorderBlocksByDrop(
                    touchItem.dataset.blockId,
                    dropBlock.dataset.blockId
                );
            }

            // Reset styles
            touchItem.style.position = '';
            touchItem.style.opacity = '';
            touchItem.style.zIndex = '';
            touchItem.style.left = '';
            touchItem.style.top = '';
            touchItem.style.pointerEvents = '';
            touchItem.style.transition = '';

            document.querySelectorAll('.operation-block').forEach(block => {
                block.classList.remove('drag-over');
            });

            touchItem = null;
        });
    }

    // Enhanced error handling
    async handleError(error, context) {
        console.error(`Error in ${context}:`, error);
        
        const errorMessage = error.message || 'An unexpected error occurred';
        
        frappe.show_alert({
            message: `❌ ${errorMessage}`,
            indicator: 'red',
            actions: [{
                label: 'Report Issue',
                action: () => {
                    this.reportError(error, context);
                }
            }]
        });
        
        // Log to server if needed
        if (this.shouldLogError(error)) {
            await this.logErrorToServer(error, context);
        }
    }

    shouldLogError(error) {
        // Don't log network errors or user cancellations
        return !(error.name === 'NetworkError' || error.name === 'AbortError');
    }

    async logErrorToServer(error, context) {
        try {
            await frappe.call({
                method: 'frappe.utils.error.log_error',
                args: {
                    title: `Operation Guide Error: ${context}`,
                    error: error.stack || error.message
                }
            });
        } catch (e) {
            console.error('Failed to log error to server:', e);
        }
    }

    reportError(error, context) {
        const report = `
Context: ${context}
Error: ${error.message}
Stack: ${error.stack || 'N/A'}
Browser: ${navigator.userAgent}
Time: ${new Date().toISOString()}
        `;
        
        frappe.msgprint({
            title: 'Error Report',
            message: `<pre>${frappe.utils.escape_html(report)}</pre>`,
            indicator: 'red'
        });
    }

    // Cleanup
    destroy() {
        // Remove event listeners
        document.removeEventListener('keydown', this.handleKeyboard);
        
        // Clear observers
        this.observers.forEach(observer => observer.disconnect());
        this.observers.clear();
        
        // Clear intervals
        if (this.autoSaveInterval) {
            clearInterval(this.autoSaveInterval);
        }
        
        // Save draft one last time
        this.saveDraft();
        
        // Cleanup global references
        this.cleanupBlockData();
    }

    // Enhanced rendering methods
    renderBlockContent(block, index) {
        const content = this.getBlockMainContent(block);
        const blockType = this.getBlockType(block);
        
        if (!content) {
            return "<p style='color: #7f8c8d; font-style: italic;'>Empty block</p>";
        }

        switch (blockType) {
            case 'Header':
                return `<h1 style="color: #2c3e50; margin: 0; font-size: 28px; font-weight: 700; border-bottom: 3px solid #3498db; padding-bottom: 10px;">${this.sanitizeContent(block.header)}</h1>`;
                
            case 'Title':
                return `<h3 style="color: #34495e; margin: 0; font-size: 22px; font-weight: 600;">${this.sanitizeContent(block.title)}</h3>`;
                
            case 'List':
                const items = block.list.split("\n").filter(item => item.trim());
                return `<ul style="margin: 0; padding-left: 20px; line-height: 1.6;">${items.map(item => `<li style="margin-bottom: 8px;">${this.sanitizeContent(item)}</li>`).join("")}</ul>`;
                
            case 'Text':
                return `<div style="margin: 0; white-space: pre-wrap; line-height: 1.6; color: #2c3e50; font-size: 15px;">${this.sanitizeContent(block.text)}</div>`;
                
            case 'JS Code':
                return this.renderEnhancedCodeBlock(block.js_code, "javascript", `js_${index}`);
                
            case 'Python Code':
                return this.renderEnhancedCodeBlock(block.python_code, "python", `py_${index}`);
                
            case 'Photo':
                return this.renderEnhancedPhotoBlock(block.photo, `photo_${index}`);
                
            case 'Attachment':
                const fileName = block.attachment.split('/').pop();
                const fileExt = fileName.split('.').pop().toLowerCase();
                const icon = this.getFileIcon(fileExt);
                return `
                    <a href="${block.attachment}" target="_blank" class="attachment-link">
                        <span class="file-icon">${icon}</span>
                        <span class="file-name">${fileName}</span>
                        <span class="file-size">${this.formatFileSize(0)}</span>
                    </a>
                `;
                
            case 'Link':
                const domain = new URL(block.link).hostname;
                return `
                    <a href="${block.link}" target="_blank" class="external-link">
                        <img src="https://www.google.com/s2/favicons?domain=${domain}" alt="" class="favicon">
                        <span>${block.link}</span>
                        <i class="fa fa-external-link"></i>
                    </a>
                `;
                
            default:
                return "<p style='color: #7f8c8d; font-style: italic;'>Unknown block type</p>";
        }
    }

    getBlockMainContent(block) {
        const fields = ['header', 'title', 'list', 'text', 'js_code', 'python_code', 'photo', 'attachment', 'link'];
        for (const field of fields) {
            if (block[field]) return block[field];
        }
        return null;
    }

    sanitizeContent(content) {
        // Enhanced XSS protection
        const div = document.createElement('div');
        div.textContent = content;
        return div.innerHTML;
    }

    getFileIcon(extension) {
        const iconMap = {
            pdf: '📄',
            doc: '📝',
            docx: '📝',
            xls: '📊',
            xlsx: '📊',
            ppt: '📊',
            pptx: '📊',
            zip: '🗜️',
            rar: '🗜️',
            mp4: '🎥',
            mp3: '🎵',
            png: '🖼️',
            jpg: '🖼️',
            jpeg: '🖼️',
            gif: '🖼️'
        };
        
        return iconMap[extension] || '📎';
    }

    formatFileSize(bytes) {
        // TODO: Get actual file size from server
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        if (bytes === 0) return 'Unknown size';
        const i = Math.floor(Math.log(bytes) / Math.log(1024));
        return Math.round(bytes / Math.pow(1024, i) * 100) / 100 + ' ' + sizes[i];
    }

    renderEnhancedCodeBlock(code, language, id) {
        const lines = code.split("\n");
        const isLong = lines.length > 10;
        
        // Add line numbers
        const numberedLines = lines.map((line, i) => ({
            number: i + 1,
            content: line
        }));
        
        const displayLines = isLong ? numberedLines.slice(0, 10) : numberedLines;
        
        let html = `
            <div class="enhanced-code-block" id="${id}" data-language="${language}">
                <div class="code-header">
                    <span class="code-language">${language}</span>
                    <div class="code-actions">
                        <button class="code-action-btn" onclick="window.copyCodeBlock('${id}')" title="Copy">
                            <i class="fa fa-copy"></i>
                        </button>
                        ${isLong ? `
                            <button class="code-action-btn" onclick="window.toggleCodeExpansion('${id}')" title="Expand">
                                <i class="fa fa-expand"></i>
                            </button>
                        ` : ''}
                    </div>
                </div>
                <div class="code-content">
                    <table class="code-table">
                        <tbody>
        `;
        
        displayLines.forEach(line => {
            html += `
                <tr>
                    <td class="line-number">${line.number}</td>
                    <td class="line-content"><pre>${this.sanitizeContent(line.content)}</pre></td>
                </tr>
            `;
        });
        
        if (isLong) {
            html += `
                <tr class="code-more">
