window.copyOperationBlockContent = function(docname) {
    if (window.operationGuide) {
        const blockDataId = `block_data_${docname}`;
        const blockData = window[blockDataId];
        
        if (blockData) {
            let contentToCopy = '';
            
            // Extract content based on block type
            if (blockData.header) {
                contentToCopy = blockData.header;
            } else if (blockData.title) {
                contentToCopy = blockData.title;
            } else if (blockData.list) {
                contentToCopy = blockData.list;
            } else if (blockData.text) {
                contentToCopy = blockData.text;
            } else if (blockData.js_code) {
                contentToCopy = blockData.js_code;
            } else if (blockData.python_code) {
                contentToCopy = blockData.python_code;
            } else if (blockData.link) {
                contentToCopy = blockData.link;
            } else {
                frappe.show_alert('No copyable content found in this block', 'orange');
                return;
            }
            
            // Copy to clipboard
            if (navigator.clipboard && window.isSecureContext) {
                // Use modern clipboard API
                navigator.clipboard.writeText(contentToCopy).then(() => {
                    frappe.show_alert('📋 Content copied to clipboard!', 'green');
                }).catch(err => {
                    console.error('Failed to copy content:', err);
                    // Fallback to old method
                    window.copyOperationBlockContentFallback(contentToCopy);
                });
            } else {
                // Fallback for older browsers or non-secure contexts
                window.copyOperationBlockContentFallback(contentToCopy);
            }
        } else {
            console.error('Block data not found for:', blockDataId);
            frappe.show_alert('Block data not found', 'red');
        }
    } else {
        console.error('operationGuide not found in window');
    }
};

window.copyOperationBlockContentFallback = function(text) {
    // Create a temporary textarea element
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.left = '-999999px';
    textarea.style.top = '-999999px';
    document.body.appendChild(textarea);
    
    try {
        textarea.focus();
        textarea.select();
        document.execCommand('copy');
        frappe.show_alert('📋 Content copied to clipboard!', 'green');
    } catch (err) {
        console.error('Fallback copy failed:', err);
        frappe.show_alert('Failed to copy content to clipboard', 'red');
    } finally {
        document.body.removeChild(textarea);
    }
};

window.editOperationBlock = function(docname) {
    if (window.operationGuide) {
        const blockDataId = `block_data_${docname}`;
        const blockData = window[blockDataId];
        if (blockData) {
            window.operationGuide.editBlock(docname, blockData);
        } else {
            frappe.show_alert('Block data not found', 'red');
        }
    }
};

window.duplicateOperationBlock = function(docname) {
    if (window.operationGuide) {
        window.operationGuide.duplicateBlock(docname);
    }
};

window.deleteOperationBlock = function(docname, blockType) {
    if (window.operationGuide) {
        window.operationGuide.deleteBlock(docname, blockType);
    }
};