/**
 * Enhanced Operation Guide Manager for Frappe
 * Provides a rich block-based editor for creating operation guides
 */

class OperationGuideManager {
    constructor(frm) {
        this.frm = frm;
        this.blocks = [];
        this.currentEditingBlock = null;
        this.searchTerm = '';
        this.showPageBreaks = false;
        
        // Enhanced properties
        this.undoStack = [];
        this.redoStack = [];
        this.blockTemplates = this.getDefaultTemplates();
        this.shortcuts = new Map();
        this.observers = new Map();
        
        // A4 dimensions in pixels (at 96 DPI with margins)
        this.A4_HEIGHT = 1040;
        
        // Performance optimization
        this.debouncedSearch = this.debounce(this.performSearch.bind(this), 300);
        
        // Bind methods
        this.bindMethods();
        
        this.init();
    }

    bindMethods() {
        // Bind all methods to preserve context
        const methods = [
            'handleAddBlock', 'handleSearch', 'handleDragStart', 
            'handleDragOver', 'handleDrop', 'handleKeyboard',
            'handleDragEnd', 'handleDragEnter', 'handleDragLeave'
        ];
        
        methods.forEach(method => {
            this[method] = this[method].bind(this);
        });
    }

    init() {
        if (!this.frm.doc.__islocal) {
            this.renderOperationUI();
            this.loadExistingBlocks();
            this.setupKeyboardShortcuts();
            this.setupAutoSave();
        } else {
            this.renderSaveMessage();
        }
    }

    // Enhanced template system
    getDefaultTemplates() {
        return {
            'meeting_notes': {
                name: 'Meeting Notes',
                blocks: [
                    { type: 'Header', content: 'Meeting Notes - [Date]' },
                    { type: 'Title', content: 'Attendees' },
                    { type: 'List', content: 'Name 1\nName 2\nName 3' },
                    { type: 'Title', content: 'Agenda' },
                    { type: 'Text', content: 'Meeting objectives...' },
                    { type: 'Title', content: 'Action Items' },
                    { type: 'List', content: 'Action item 1\nAction item 2' }
                ]
            },
            'procedure': {
                name: 'Standard Procedure',
                blocks: [
                    { type: 'Header', content: 'Procedure: [Name]' },
                    { type: 'Title', content: 'Purpose' },
                    { type: 'Text', content: 'This procedure describes...' },
                    { type: 'Title', content: 'Steps' },
                    { type: 'List', content: 'Step 1: ...\nStep 2: ...\nStep 3: ...' },
                    { type: 'Title', content: 'Safety Considerations' },
                    { type: 'Text', content: 'Important safety notes...' }
                ]
            }
        };
    }

    setupKeyboardShortcuts() {
        // Define keyboard shortcuts
        this.shortcuts.set('ctrl+z', () => this.undo());
        this.shortcuts.set('ctrl+y', () => this.redo());
        this.shortcuts.set('ctrl+s', () => this.saveAll());
        this.shortcuts.set('ctrl+/', () => this.showShortcutsHelp());
        this.shortcuts.set('ctrl+n', () => this.handleAddBlock());
        this.shortcuts.set('ctrl+f', () => this.focusSearch());
        
        // Setup listener
        document.addEventListener('keydown', this.handleKeyboard);
    }

    handleKeyboard(e) {
        const key = this.getKeyCombo(e);
        const handler = this.shortcuts.get(key);
        
        if (handler) {
            e.preventDefault();
            handler();
        }
    }

    getKeyCombo(e) {
        const parts = [];
        if (e.ctrlKey || e.metaKey) parts.push('ctrl');
        if (e.altKey) parts.push('alt');
        if (e.shiftKey) parts.push('shift');
        
        const key = e.key.toLowerCase();
        if (key !== 'control' && key !== 'alt' && key !== 'shift' && key !== 'meta') {
            parts.push(key);
        }
        
        return parts.join('+');
    }

    setupAutoSave() {
        // Auto-save draft to localStorage every 30 seconds
        setInterval(() => {
            this.saveDraft();
        }, 30000);
        
        // Save on page unload
        window.addEventListener('beforeunload', () => {
            this.saveDraft();
        });
    }

    saveDraft() {
        const draft = {
            blocks: this.blocks,
            timestamp: new Date().toISOString()
        };
        
        try {
            localStorage.setItem(`operation_guide_draft_${this.frm.doc.name}`, JSON.stringify(draft));
        } catch (e) {
            console.warn('Failed to save draft:', e);
        }
    }

    loadDraft() {
        try {
            const draft = localStorage.getItem(`operation_guide_draft_${this.frm.doc.name}`);
            if (draft) {
                const data = JSON.parse(draft);
                frappe.show_alert({
                    message: `Draft found from ${new Date(data.timestamp).toLocaleString()}. Load it?`,
                    indicator: 'blue',
                    actions: [
                        {
                            label: 'Load Draft',
                            action: () => {
                                this.blocks = data.blocks;
                                this.renderBlocks();
                                frappe.show_alert('Draft loaded', 'green');
                            }
                        },
                        {
                            label: 'Discard',
                            action: () => {
                                localStorage.removeItem(`operation_guide_draft_${this.frm.doc.name}`);
                            }
                        }
                    ]
                });
            }
        } catch (e) {
            console.warn('Failed to load draft:', e);
        }
    }

    // Undo/Redo functionality
    pushToUndoStack(action) {
        this.undoStack.push(action);
        this.redoStack = []; // Clear redo stack on new action
        
        // Limit stack size
        if (this.undoStack.length > 50) {
            this.undoStack.shift();
        }
    }

    async undo() {
        if (this.undoStack.length === 0) {
            frappe.show_alert('Nothing to undo', 'orange');
            return;
        }
        
        const action = this.undoStack.pop();
        this.redoStack.push(action);
        
        await this.reverseAction(action);
        frappe.show_alert('Action undone', 'blue');
    }

    async redo() {
        if (this.redoStack.length === 0) {
            frappe.show_alert('Nothing to redo', 'orange');
            return;
        }
        
        const action = this.redoStack.pop();
        this.undoStack.push(action);
        
        await this.applyAction(action);
        frappe.show_alert('Action redone', 'blue');
    }

    async reverseAction(action) {
        switch (action.type) {
            case 'add':
                await this.deleteBlock(action.blockId, action.blockType, false);
                break;
            case 'delete':
                await this.restoreBlock(action.blockData);
                break;
            case 'edit':
                await this.updateBlock(action.blockId, action.fieldKey, { 
                    [action.fieldKey]: action.oldValue 
                });
                break;
            case 'reorder':
                await this.reorderBlocks(action.fromId, action.toId);
                break;
        }
        
        await this.loadExistingBlocks();
    }

    async applyAction(action) {
        switch (action.type) {
            case 'add':
                await this.restoreBlock(action.blockData);
                break;
            case 'delete':
                await this.deleteBlock(action.blockId, action.blockType, false);
                break;
            case 'edit':
                await this.updateBlock(action.blockId, action.fieldKey, { 
                    [action.fieldKey]: action.newValue 
                });
                break;
            case 'reorder':
                await this.reorderBlocks(action.toId, action.fromId);
                break;
        }
        
        await this.loadExistingBlocks();
    }

    // Performance optimization - debounce utility
    debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

    // Enhanced search with highlighting
    handleSearch(e) {
        this.searchTerm = e.target.value.toLowerCase();
        this.debouncedSearch();
    }

    performSearch() {
        const blocks = document.querySelectorAll('.operation-block');
        let visibleCount = 0;
        
        blocks.forEach(block => {
            const blockContent = block.textContent.toLowerCase();
            const contentDiv = block.querySelector('.block-content-direct');
            
            if (!this.searchTerm || blockContent.includes(this.searchTerm)) {
                block.style.display = 'block';
                block.classList.add('fade-in');
                visibleCount++;
                
                // Highlight search terms
                if (this.searchTerm && contentDiv) {
                    this.highlightSearchTerms(contentDiv, this.searchTerm);
                } else if (contentDiv) {
                    this.removeHighlights(contentDiv);
                }
            } else {
                block.style.display = 'none';
            }
        });
        
        this.toggleEmptyState(visibleCount === 0);
    }

    highlightSearchTerms(element, searchTerm) {
        this.removeHighlights(element);
        
        const walker = document.createTreeWalker(
            element,
            NodeFilter.SHOW_TEXT,
            null,
            false
        );
        
        const textNodes = [];
        let node;
        
        while (node = walker.nextNode()) {
            textNodes.push(node);
        }
        
        textNodes.forEach(textNode => {
            const text = textNode.textContent;
            const regex = new RegExp(`(${searchTerm})`, 'gi');
            
            if (regex.test(text)) {
                const span = document.createElement('span');
                span.innerHTML = text.replace(regex, '<mark class="search-highlight">$1</mark>');
                textNode.parentNode.replaceChild(span, textNode);
            }
        });
    }

    removeHighlights(element) {
        element.querySelectorAll('mark.search-highlight').forEach(mark => {
            const parent = mark.parentNode;
            parent.replaceChild(document.createTextNode(mark.textContent), mark);
            parent.normalize();
        });
    }

    focusSearch() {
        const searchInput = document.getElementById('block_search');
        if (searchInput) {
            searchInput.focus();
            searchInput.select();
        }
    }

