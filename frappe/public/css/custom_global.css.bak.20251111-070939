/* ================================================
   Global Font: Almarai Regular
   ================================================ */

@font-face {
  font-family: 'Almarai';
  src: url('/files/Almarai-Light.ttf') format('truetype');
  font-weight: Light;
  font-style: Light;
}

/* Apply globally */
html, body, * {
  font-family: 'Almarai', 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
  font-weight: Light !important;
}

