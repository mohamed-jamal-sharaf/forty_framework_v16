/* ================================================
   Global Font: Almarai Bold
   ================================================ */

@font-face {
  font-family: 'Almarai';
  src: url('/files/Almarai-Bold.ttf') format('truetype');
  font-weight: bold;
  font-style: normal;
}

html, body, * {
  font-family: 'Almarai', 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
  font-weight: bold !important;
}
