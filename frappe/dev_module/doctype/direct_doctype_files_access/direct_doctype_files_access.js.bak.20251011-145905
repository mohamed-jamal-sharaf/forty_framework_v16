// DocType: Direct Doctype Files Access

frappe.ui.form.on('Direct Doctype Files Access', {
  onload(frm) {
    set_link_query(frm);
  },
  refresh(frm) {
    set_link_query(frm);
  },
  dev_module(frm) {
    frm.set_value('target_doctype', '');
    set_link_query(frm);
  },
  validate(frm) {
    const excluded = ['Direct Doctype Files Access', 'CODE EDITOR Pro'];
    if (excluded.includes(frm.doc.target_doctype)) {
      frappe.throw(__('This DocType is not allowed to be selected.'));
    }
  }
});

function set_link_query(frm) {
  const excluded = ['Direct Doctype Files Access', 'CODE EDITOR Pro'];

  frm.set_query('target_doctype', () => {
    // Use your real dotted path here:
    const query_path = 'your_app.your_module.doctype.direct_doctype_files_access.direct_doctype_files_access.doctypes_query';
    return {
      query: query_path,
      filters: {
        module: frm.doc.dev_module || null,
        excluded // not used on server; keeping here if you later want it
      }
    };
  });
}
