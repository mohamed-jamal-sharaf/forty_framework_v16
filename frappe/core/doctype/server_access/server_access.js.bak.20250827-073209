frappe.ui.form.on('Server Access', {
  refresh(frm) {
    frm.add_custom_button(__('Load Files'), () => loadFiles(frm), 'Actions');
    frm.add_custom_button(__('Save File'), () => saveFile(frm), 'Actions');
    frm.add_custom_button(__('Open in Code Editor'), () => openInCodeEditor(frm), 'Actions');
    setEditorMode(frm);
    
    // Initialize the code editor HTML field
    if (frm.fields_dict.code_editor_html) {
      frm.fields_dict.code_editor_html.$wrapper.html(`
        <div class="monaco-editor-container" style="position: relative; width: 100%; height: 600px; border: 1px solid #d1d8dd; border-radius: 4px;">
          <div class="editor-toolbar" style="background: #f5f5f5; border-bottom: 1px solid #d1d8dd; padding: 8px; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <button class="btn btn-xs btn-default editor-theme-toggle">🌙 Dark Theme</button>
              <button class="btn btn-xs btn-default editor-font-size-increase">A+</button>
              <button class="btn btn-xs btn-default editor-font-size-decrease">A-</button>
              <button class="btn btn-xs btn-default editor-format">✨ Format</button>
            </div>
            <div>
              <span class="editor-status" style="font-size: 12px; color: #666;"></span>
            </div>
          </div>
          <div id="monaco-editor-instance" style="width: 100%; height: calc(100% - 45px);"></div>
        </div>
      `);
    }
  },
  
  target_doctype(frm) {
    loadFiles(frm);
  },
  
  filename(frm) {
    if (!frm.doc.filename) return;
    loadFileContent(frm);
    setEditorMode(frm);
  }
});

// Global variable to store Monaco editor instance
let monacoEditor = null;
let monacoInitialized = false;

function setEditorMode(frm) {
  const fn = frm.doc.filename || '';
  const ext = fn.split('.').pop().toLowerCase();
  const field = frm.get_field('file_content');
  if (!field || !field.editor) return;
  
  let mode = 'text';
  if (ext === 'py') mode = 'python';
  else if (ext === 'js') mode = 'javascript';
  else if (ext === 'json') mode = 'json';
  else if (ext === 'md') mode = 'markdown';
  else if (ext === 'html') mode = 'html';
  else if (ext === 'css') mode = 'css';
  
  try { 
    field.editor.session.setMode("ace/mode/" + mode); 
  } catch(e) {}
}

function loadFiles(frm) {
  if (!frm.doc.target_doctype) {
    frappe.msgprint(__('Select Target DocType first.'));
    return;
  }
  
  frappe.call({
    method: "frappe.core.doctype.server_access.server_access.list_doctype_files",
    args: { target_doctype: frm.doc.target_doctype },
    callback: r => {
      const files = r.message || [];
      frm.set_df_property('filename', 'options', files.join('\n'));
      
      if (files.length) {
        frm.set_value('filename', files[0]);
        loadFileContent(frm);
      } else {
        frm.set_value('filename', null);
        frm.set_value('file_content', '');
        frm.set_value('last_op_log', __('No editable files found.'));
      }
    }
  });
}

function loadFileContent(frm) {
  if (!frm.doc.target_doctype || !frm.doc.filename) return;
  
  frappe.call({
    method: "frappe.core.doctype.server_access.server_access.read_doctype_file",
    args: {
      target_doctype: frm.doc.target_doctype,
      filename: frm.doc.filename
    },
    callback: r => {
      frm.set_value('file_content', r.message || '');
      frm.set_value('last_op_log', __('Loaded ') + frm.doc.filename);
    }
  });
}

function saveFile(frm) {
  if (!frm.doc.target_doctype || !frm.doc.filename) {
    frappe.msgprint(__('Choose DocType and File first.'));
    return;
  }
  
  // Get content from Monaco editor if it's open
  let content = frm.doc.file_content || '';
  if (monacoEditor && frm.fields_dict.code_editor_html.$wrapper.find('#monaco-editor-instance').is(':visible')) {
    content = monacoEditor.getValue();
  }
  
  frappe.call({
    method: "frappe.core.doctype.server_access.server_access.save_doctype_file",
    args: {
      target_doctype: frm.doc.target_doctype,
      filename: frm.doc.filename,
      content: content
    },
    callback: r => {
      frm.set_value('last_op_log', r.message || 'Saved');
      frappe.show_alert({message: __('Saved'), indicator: 'green'});
      // Update the file_content field with the saved content
      frm.set_value('file_content', content);
    },
    error: () => {
      frappe.show_alert({message: __('Save failed'), indicator: 'red'});
    }
  });
}

function openInCodeEditor(frm) {
  if (!frm.doc.filename || !frm.doc.file_content) {
    frappe.msgprint(__('Please select a file first'));
    return;
  }
  
  // Load Monaco Editor if not already loaded
  if (!monacoInitialized) {
    loadMonacoEditor(() => {
      initializeMonacoEditor(frm);
    });
  } else {
    initializeMonacoEditor(frm);
  }
  
  // Show the code editor HTML field
  frm.toggle_display('code_editor_html', true);
  frm.scroll_to_field('code_editor_html');
}

function loadMonacoEditor(callback) {
  // Check if Monaco is already loaded
  if (window.monaco) {
    monacoInitialized = true;
    callback();
    return;
  }
  
  // Load Monaco Editor from CDN
  const monacoLoaderScript = document.createElement('script');
  monacoLoaderScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js';
  monacoLoaderScript.onload = () => {
    require.config({ 
      paths: { 
        'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs' 
      }
    });
    
    require(['vs/editor/editor.main'], () => {
      monacoInitialized = true;
      setupFrappeCompletions();
      callback();
    });
  };
  
  document.head.appendChild(monacoLoaderScript);
}

function getLanguageFromFilename(filename) {
  const ext = filename.split('.').pop().toLowerCase();
  const languageMap = {
    'py': 'python',
    'js': 'javascript',
    'json': 'json',
    'html': 'html',
    'css': 'css',
    'scss': 'scss',
    'sql': 'sql',
    'md': 'markdown',
    'yml': 'yaml',
    'yaml': 'yaml',
    'xml': 'xml',
    'txt': 'plaintext'
  };
  
  return languageMap[ext] || 'plaintext';
}

function initializeMonacoEditor(frm) {
  const container = document.getElementById('monaco-editor-instance');
  const language = getLanguageFromFilename(frm.doc.filename);
  
  // Dispose previous editor if exists
  if (monacoEditor) {
    monacoEditor.dispose();
  }
  
  // Create Monaco Editor
  monacoEditor = monaco.editor.create(container, {
    value: frm.doc.file_content,
    language: language,
    theme: 'vs',
    automaticLayout: true,
    minimap: {
      enabled: true
    },
    fontSize: 14,
    wordWrap: 'on',
    scrollBeyondLastLine: false,
    renderWhitespace: 'selection',
    suggestOnTriggerCharacters: true,
    quickSuggestions: true,
    suggest: {
      showMethods: true,
      showFunctions: true,
      showConstructors: true,
      showFields: true,
      showVariables: true,
      showClasses: true,
      showStructs: true,
      showInterfaces: true,
      showModules: true,
      showProperties: true,
      showEvents: true,
      showOperators: true,
      showUnits: true,
      showValues: true,
      showConstants: true,
      showEnums: true,
      showEnumMembers: true,
      showKeywords: true,
      showWords: true,
      showColors: true,
      showFiles: true,
      showReferences: true,
      showFolders: true,
      showTypeParameters: true,
      showSnippets: true
    }
  });
  
  // Setup event handlers
  setupEditorEventHandlers(frm);
  
  // Update status
  updateEditorStatus(frm);
  
  // Sync changes back to the original field
  monacoEditor.onDidChangeModelContent(() => {
    const content = monacoEditor.getValue();
    frm.set_value('file_content', content, false, true);
  });
}

function setupEditorEventHandlers(frm) {
  const wrapper = frm.fields_dict.code_editor_html.$wrapper;
  
  // Theme toggle
  wrapper.find('.editor-theme-toggle').off('click').on('click', function() {
    const currentTheme = monacoEditor.getOptions()._values.theme;
    const newTheme = currentTheme === 'vs' ? 'vs-dark' : 'vs';
    monacoEditor.updateOptions({ theme: newTheme });
    $(this).text(newTheme === 'vs' ? '🌙 Dark Theme' : '☀️ Light Theme');
  });
  
  // Font size controls
  wrapper.find('.editor-font-size-increase').off('click').on('click', function() {
    const currentSize = monacoEditor.getOptions()._values.fontSize;
    monacoEditor.updateOptions({ fontSize: currentSize + 2 });
  });
  
  wrapper.find('.editor-font-size-decrease').off('click').on('click', function() {
    const currentSize = monacoEditor.getOptions()._values.fontSize;
    monacoEditor.updateOptions({ fontSize: Math.max(10, currentSize - 2) });
  });
  
  // Format button
  wrapper.find('.editor-format').off('click').on('click', function() {
    monacoEditor.getAction('editor.action.formatDocument').run();
  });
}

function updateEditorStatus(frm) {
  const wrapper = frm.fields_dict.code_editor_html.$wrapper;
  const language = getLanguageFromFilename(frm.doc.filename);
  const lines = monacoEditor.getValue().split('\n').length;
  
  wrapper.find('.editor-status').text(`${frm.doc.filename} • ${language} • ${lines} lines`);
}

function setupFrappeCompletions() {
  // Register Frappe API completions for JavaScript and Python
  
  // JavaScript Frappe API
  monaco.languages.registerCompletionItemProvider('javascript', {
    provideCompletionItems: (model, position) => {
      const suggestions = [
        // Frappe Call API
        {
          label: 'frappe.call',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: `frappe.call({
    method: '\${1:method_path}',
    args: {
        \${2:arg}: \${3:value}
    },
    callback: function(r) {
        \${4:// handle response}
    }
});`,
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
          documentation: 'Make a server call to a whitelisted method'
        },
        // Frappe Message API
        {
          label: 'frappe.msgprint',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: 'frappe.msgprint(__(\'${1:message}\'));',
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
          documentation: 'Show a message to the user'
        },
        // Frappe Dialog API
        {
          label: 'frappe.prompt',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: `frappe.prompt([
    {
        label: '\${1:Field Label}',
        fieldname: '\${2:field_name}',
        fieldtype: '\${3:Data}'
    }
], (values) => {
    \${4:// handle values}
}, '\${5:Dialog Title}', '\${6:Submit}');`,
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
          documentation: 'Show a prompt dialog'
        },
        // More Frappe APIs
        {
          label: 'frappe.show_alert',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: 'frappe.show_alert({message: __(\'${1:message}\'), indicator: \'${2:green}\'});',
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet
        },
        {
          label: 'frappe.db.get_value',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: `frappe.db.get_value('\${1:DocType}', '\${2:name}', '\${3:field}', (r) => {
    \${4:// handle value}
});`,
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet
        },
        {
          label: 'frappe.model.get_value',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: `frappe.model.get_value('\${1:DocType}', '\${2:name}', '\${3:field}');`,
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet
        },
        {
          label: 'frappe.route_options',
          kind: monaco.languages.CompletionItemKind.Variable,
          insertText: `frappe.route_options = {
    \${1:field}: \${2:value}
};`,
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet
        },
        {
          label: 'frappe.set_route',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: `frappe.set_route('\${1:List}', '\${2:DocType}');`,
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet
        }
      ];
      
      return { suggestions: suggestions };
    }
  });
  
  // Python Frappe API
  monaco.languages.registerCompletionItemProvider('python', {
    provideCompletionItems: (model, position) => {
      const suggestions = [
        {
          label: 'frappe.get_doc',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: 'frappe.get_doc("${1:doctype}", "${2:name}")',
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
          documentation: 'Get a document from the database'
        },
        {
          label: 'frappe.get_all',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: `frappe.get_all("\${1:DocType}", 
    filters={\${2}},
    fields=["\${3:field1}", "\${4:field2}"]
)`,
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet
        },
        {
          label: '@frappe.whitelist()',
          kind: monaco.languages.CompletionItemKind.Snippet,
          insertText: `@frappe.whitelist()
def \${1:function_name}(\${2:args}):
    \${3:pass}`,
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet,
          documentation: 'Whitelist a function for API access'
        },
        {
          label: 'frappe.throw',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: 'frappe.throw(_("${1:Error message}"))',
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet
        },
        {
          label: 'frappe.msgprint',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: 'frappe.msgprint(_("${1:message}"))',
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet
        },
        {
          label: 'frappe.db.sql',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: `frappe.db.sql("""
    SELECT \${1:*}
    FROM \\\`tab\${2:DocType}\\\`
    WHERE \${3:condition}
""", as_dict=True)`,
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet
        },
        {
          label: 'frappe.new_doc',
          kind: monaco.languages.CompletionItemKind.Function,
          insertText: `doc = frappe.new_doc("\${1:DocType}")
doc.\${2:field} = \${3:value}
doc.insert()`,
          insertTextRules: monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet
        }
      ];
      
      return { suggestions: suggestions };
    }
  });
}