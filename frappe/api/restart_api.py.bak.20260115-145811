# =====================================================
# CONFIGURATION - Update these for your server
# =====================================================
CONFIG = {
    "bench_user": "frappe",
    "bench_path": "/home/frappe/forty-bench",
    "supervisor_group": "forty-bench-web",
    "site": "fortycloud.io"
}
# =====================================================

CACHE_PREFIX = "bench_operation_"


def get_progress(operation_id):
    """Get operation progress from Redis cache"""
    try:
        data = frappe.cache().get_value(f"{CACHE_PREFIX}{operation_id}")
        if data:
            return json.loads(data)
    except:
        pass
    return None


def set_progress(operation_id, data):
    """Set operation progress in Redis cache"""
    try:
        frappe.cache().set_value(
            f"{CACHE_PREFIX}{operation_id}",
            json.dumps(data),
            expires_in_sec=3600
        )
    except Exception as e:
        print(f"Cache error: {e}")


def add_log(operation_id, message):
    """Add a log entry"""
    data = get_progress(operation_id)
    if data:
        timestamp = get_datetime_str(now_datetime())
        data["logs"].append({
            "time": timestamp,
            "message": str(message)
        })
        data["message"] = str(message)[:100]
        set_progress(operation_id, data)


def update_progress(operation_id, progress, message):
    """Update progress"""
    data = get_progress(operation_id)
    if data:
        data["progress"] = progress
        data["message"] = str(message)[:100]
        set_progress(operation_id, data)


def complete_operation(operation_id, success=True, message=""):
    """Mark operation complete"""
    data = get_progress(operation_id)
    if data:
        data["status"] = "completed" if success else "error"
        data["progress"] = 100
        data["message"] = message
        data["completed_at"] = get_datetime_str(now_datetime())
        set_progress(operation_id, data)


def init_operation(operation_id, operation_type):
    """Initialize a new operation"""
    data = {
        "operation": operation_type,
        "status": "running",
        "progress": 5,
        "message": "Initializing...",
        "started_at": get_datetime_str(now_datetime()),
        "logs": []
    }
    set_progress(operation_id, data)
    return data


# =====================================================
# MIGRATE
# =====================================================

@frappe.whitelist()
def run_migrate(sudo_password=None):
    """Run bench migrate"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    
    operation_id = f"migrate_{int(time.time())}"
    init_operation(operation_id, "migrate")
    
    thread = threading.Thread(target=_do_migrate, args=(operation_id, sudo_password), daemon=True)
    thread.start()
    
    return {"success": True, "operation_id": operation_id}


def _do_migrate(operation_id, sudo_password=None):
    """Execute migrate in background"""
    try:
        site = CONFIG["site"]
        bench_path = CONFIG["bench_path"]
        bench_user = CONFIG["bench_user"]
        
        add_log(operation_id, f"📦 Starting migration for: {site}")
        update_progress(operation_id, 10, "Starting migration...")
        
        # Run as frappe user using sudo -u
        # This is important because bench commands need to run as the bench owner
        if sudo_password:
            # Use sudo with password to run as frappe user
            cmd = f"echo '{sudo_password}' | sudo -S -u {bench_user} bash -c 'cd {bench_path} && bench --site {site} migrate'"
        else:
            # Try running as frappe user without password (may work if sudoers configured)
            cmd = f"sudo -u {bench_user} bash -c 'cd {bench_path} && bench --site {site} migrate'"
        
        add_log(operation_id, f"📋 Running migration as user: {bench_user}")
        update_progress(operation_id, 15, "Running migrations...")
        
        # Execute command
        try:
            result = subprocess.run(
                cmd,
                shell=True,
                capture_output=True,
                text=True,
                timeout=600,
                cwd=bench_path,
                env={
                    **os.environ,
                    "PYTHONUNBUFFERED": "1",
                    "HOME": f"/home/{bench_user}",
                    "USER": bench_user
                }
            )
            
            # Log output line by line with progress
            if result.stdout:
                lines = [l.strip() for l in result.stdout.strip().split('\n') if l.strip()]
                total = len(lines)
                for i, line in enumerate(lines):
                    if 'password' not in line.lower():
                        add_log(operation_id, line)
                        progress = 15 + int(75 * (i + 1) / max(total, 1))
                        update_progress(operation_id, min(progress, 90), line[:60])
            
            if result.stderr:
                for line in result.stderr.strip().split('\n'):
                    line = line.strip()
                    if line and 'password' not in line.lower() and 'pkg_resources' not in line.lower():
                        add_log(operation_id, f"⚠️ {line}")
            
            if result.returncode == 0:
                add_log(operation_id, "✅ Migration completed successfully!")
                complete_operation(operation_id, True, "✅ Migration completed")
            else:
                # Check if it actually worked despite non-zero exit
                if "Updating" in (result.stdout or "") or "Syncing" in (result.stdout or ""):
                    add_log(operation_id, "✅ Migration completed!")
                    complete_operation(operation_id, True, "✅ Migration completed")
                else:
                    add_log(operation_id, f"⚠️ Exit code: {result.returncode}")
                    complete_operation(operation_id, True, "⚠️ Check logs")
                    
        except subprocess.TimeoutExpired:
            add_log(operation_id, "⏱️ Migration timed out (10 min)")
            complete_operation(operation_id, False, "❌ Timeout")
            
    except Exception as e:
        add_log(operation_id, f"❌ Exception: {str(e)}")
        complete_operation(operation_id, False, f"❌ {str(e)}")


# =====================================================
# RESTART
# =====================================================

@frappe.whitelist()
def restart_bench(sudo_password=None):
    """Restart bench"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    
    operation_id = f"restart_{int(time.time())}"
    init_operation(operation_id, "restart")
    
    thread = threading.Thread(target=_do_restart, args=(operation_id, sudo_password), daemon=True)
    thread.start()
    
    return {"success": True, "operation_id": operation_id}


@frappe.whitelist()
def restart_bench_with_sudo(sudo_password):
    """Restart with sudo"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    if not sudo_password:
        frappe.throw(_("Sudo password required"))
    return restart_bench(sudo_password)


def _do_restart(operation_id, sudo_password=None):
    """Execute restart in background"""
    try:
        supervisor_group = CONFIG["supervisor_group"]
        
        add_log(operation_id, f"🔄 Restarting: {supervisor_group}")
        update_progress(operation_id, 10, "Starting restart...")
        
        if sudo_password:
            cmd = f"echo '{sudo_password}' | sudo -S supervisorctl restart {supervisor_group}:"
            add_log(operation_id, "🔐 Using sudo...")
        else:
            cmd = f"supervisorctl restart {supervisor_group}:"
        
        update_progress(operation_id, 30, f"Restarting {supervisor_group}...")
        
        result = subprocess.run(
            cmd,
            shell=True,
            capture_output=True,
            text=True,
            timeout=120,
            cwd=CONFIG["bench_path"]
        )
        
        if result.stdout:
            for line in result.stdout.strip().split('\n'):
                if line.strip() and 'password' not in line.lower():
                    add_log(operation_id, line.strip())
        
        if result.stderr:
            for line in result.stderr.strip().split('\n'):
                line = line.strip()
                if line and 'password' not in line.lower() and 'pkg_resources' not in line.lower():
                    add_log(operation_id, f"⚠️ {line}")
        
        if "started" in (result.stdout or "").lower():
            add_log(operation_id, "✅ Restart completed!")
            complete_operation(operation_id, True, "✅ Bench restarted")
        elif "error" in (result.stderr or "").lower() and "password" in (result.stderr or "").lower():
            add_log(operation_id, "❌ Sudo password incorrect")
            complete_operation(operation_id, False, "❌ Invalid sudo password")
        else:
            add_log(operation_id, "⚠️ Restart finished")
            complete_operation(operation_id, True, "⚠️ Check logs")
            
    except subprocess.TimeoutExpired:
        add_log(operation_id, "⏱️ Timeout")
        complete_operation(operation_id, True, "⚠️ May still be restarting")
    except Exception as e:
        add_log(operation_id, f"❌ Exception: {str(e)}")
        complete_operation(operation_id, False, f"❌ {str(e)}")


