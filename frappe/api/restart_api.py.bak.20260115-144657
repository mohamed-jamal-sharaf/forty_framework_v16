import os
import subprocess
import threading
import time
import sys
import json
import frappe
from frappe import _
from frappe.utils import now_datetime, get_datetime_str

# =====================================================
# CONFIGURATION - Update these for your server
# =====================================================
CONFIG = {
    "bench_user": "frappe",
    "bench_path": "/home/frappe/forty-bench",
    "supervisor_group": "forty-bench-web",
    "site": "fortycloud.io"
}
# =====================================================

# Cache key prefix
CACHE_PREFIX = "bench_operation_"


def get_progress(operation_id):
    """Get operation progress from Redis cache"""
    try:
        data = frappe.cache().get_value(f"{CACHE_PREFIX}{operation_id}")
        if data:
            return json.loads(data)
    except:
        pass
    return None


def set_progress(operation_id, data):
    """Set operation progress in Redis cache"""
    try:
        frappe.cache().set_value(
            f"{CACHE_PREFIX}{operation_id}",
            json.dumps(data),
            expires_in_sec=3600  # 1 hour expiry
        )
    except Exception as e:
        print(f"Cache error: {e}")


def add_log(operation_id, message):
    """Add a log entry"""
    data = get_progress(operation_id)
    if data:
        timestamp = get_datetime_str(now_datetime())
        data["logs"].append({
            "time": timestamp,
            "message": str(message)
        })
        data["message"] = str(message)[:100]
        set_progress(operation_id, data)


def update_progress(operation_id, progress, message):
    """Update progress"""
    data = get_progress(operation_id)
    if data:
        data["progress"] = progress
        data["message"] = str(message)[:100]
        set_progress(operation_id, data)


def complete_operation(operation_id, success=True, message=""):
    """Mark operation complete"""
    data = get_progress(operation_id)
    if data:
        data["status"] = "completed" if success else "error"
        data["progress"] = 100
        data["message"] = message
        data["completed_at"] = get_datetime_str(now_datetime())
        set_progress(operation_id, data)


def init_operation(operation_id, operation_type):
    """Initialize a new operation"""
    data = {
        "operation": operation_type,
        "status": "running",
        "progress": 5,
        "message": "Initializing...",
        "started_at": get_datetime_str(now_datetime()),
        "logs": []
    }
    set_progress(operation_id, data)
    return data


def run_shell_command(cmd, operation_id, timeout=300):
    """Run a shell command and capture output"""
    try:
        add_log(operation_id, f"🔄 Executing...")
        
        result = subprocess.run(
            cmd,
            shell=True,
            cwd=CONFIG["bench_path"],
            capture_output=True,
            text=True,
            timeout=timeout,
            env={
                **os.environ,
                "PYTHONUNBUFFERED": "1",
                "HOME": f"/home/{CONFIG['bench_user']}",
                "USER": CONFIG["bench_user"]
            }
        )
        
        # Log stdout
        if result.stdout:
            lines = result.stdout.strip().split('\n')
            for i, line in enumerate(lines):
                line = line.strip()
                if line and 'password' not in line.lower():
                    add_log(operation_id, line)
                    # Update progress based on position
                    progress = min(20 + int(70 * (i + 1) / len(lines)), 90)
                    update_progress(operation_id, progress, line[:60])
        
        # Log stderr (filter noise)
        if result.stderr:
            for line in result.stderr.strip().split('\n'):
                line = line.strip()
                if line and 'password' not in line.lower() and 'pkg_resources' not in line.lower():
                    add_log(operation_id, f"⚠️ {line}")
        
        return result.returncode == 0, result.stdout or "", result.stderr or ""
        
    except subprocess.TimeoutExpired:
        add_log(operation_id, "⏱️ Command timed out")
        return False, "", "Timeout"
    except Exception as e:
        add_log(operation_id, f"❌ Error: {str(e)}")
        return False, "", str(e)


# =====================================================
# MIGRATE
# =====================================================

@frappe.whitelist()
def run_migrate(sudo_password=None):
    """Run bench migrate"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    
    operation_id = f"migrate_{int(time.time())}"
    init_operation(operation_id, "migrate")
    
    # Start background thread
    thread = threading.Thread(target=_do_migrate, args=(operation_id,), daemon=True)
    thread.start()
    
    return {"success": True, "operation_id": operation_id}


def _do_migrate(operation_id):
    """Execute migrate in background"""
    try:
        site = CONFIG["site"]
        bench_path = CONFIG["bench_path"]
        
        add_log(operation_id, f"📦 Starting migration for: {site}")
        update_progress(operation_id, 10, "Starting migration...")
        
        cmd = f"cd {bench_path} && bench --site {site} migrate"
        
        add_log(operation_id, f"📋 Running: bench --site {site} migrate")
        update_progress(operation_id, 15, "Running migrations...")
        
        success, stdout, stderr = run_shell_command(cmd, operation_id, timeout=600)
        
        if success or "Updating" in stdout or "Syncing" in stdout:
            add_log(operation_id, "✅ Migration completed successfully!")
            complete_operation(operation_id, True, "✅ Migration completed")
        else:
            add_log(operation_id, "⚠️ Migration finished with warnings")
            complete_operation(operation_id, True, "⚠️ Check logs for details")
            
    except Exception as e:
        add_log(operation_id, f"❌ Exception: {str(e)}")
        complete_operation(operation_id, False, f"❌ {str(e)}")


# =====================================================
# RESTART
# =====================================================

@frappe.whitelist()
def restart_bench(sudo_password=None):
    """Restart bench"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    
    operation_id = f"restart_{int(time.time())}"
    init_operation(operation_id, "restart")
    
    thread = threading.Thread(target=_do_restart, args=(operation_id, sudo_password), daemon=True)
    thread.start()
    
    return {"success": True, "operation_id": operation_id}


@frappe.whitelist()
def restart_bench_with_sudo(sudo_password):
    """Restart with sudo"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    if not sudo_password:
        frappe.throw(_("Sudo password required"))
    return restart_bench(sudo_password)


def _do_restart(operation_id, sudo_password=None):
    """Execute restart in background"""
    try:
        supervisor_group = CONFIG["supervisor_group"]
        
        add_log(operation_id, f"🔄 Restarting: {supervisor_group}")
        update_progress(operation_id, 10, "Starting restart...")
        
        if sudo_password:
            cmd = f"echo '{sudo_password}' | sudo -S supervisorctl restart {supervisor_group}:"
            add_log(operation_id, "🔐 Using sudo...")
        else:
            cmd = f"supervisorctl restart {supervisor_group}:"
        
        update_progress(operation_id, 30, f"Restarting {supervisor_group}...")
        
        success, stdout, stderr = run_shell_command(cmd, operation_id, timeout=120)
        
        if "started" in stdout.lower():
            add_log(operation_id, "✅ Restart completed!")
            complete_operation(operation_id, True, "✅ Bench restarted")
        elif "error" in stderr.lower() and "password" in stderr.lower():
            add_log(operation_id, "❌ Sudo password incorrect")
            complete_operation(operation_id, False, "❌ Invalid sudo password")
        else:
            add_log(operation_id, "⚠️ Restart finished")
            complete_operation(operation_id, True, "⚠️ Check logs")
            
    except Exception as e:
        add_log(operation_id, f"❌ Exception: {str(e)}")
        complete_operation(operation_id, False, f"❌ {str(e)}")


# =====================================================
# BUILD
# =====================================================

@frappe.whitelist()
def run_build(sudo_password=None, app=None):
    """Run bench build"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    
    operation_id = f"build_{int(time.time())}"
    init_operation(operation_id, "build")
    
    thread = threading.Thread(target=_do_build, args=(operation_id, app), daemon=True)
    thread.start()
    
    return {"success": True, "operation_id": operation_id}


def _do_build(operation_id, app=None):
    """Execute build in background"""
    try:
        bench_path = CONFIG["bench_path"]
        
        if app:
            cmd = f"cd {bench_path} && bench build --app {app}"
            add_log(operation_id, f"🔨 Building: {app}")
        else:
            cmd = f"cd {bench_path} && bench build"
            add_log(operation_id, "🔨 Building all apps...")
        
        update_progress(operation_id, 10, "Starting build...")
        
        success, stdout, stderr = run_shell_command(cmd, operation_id, timeout=600)
        
        if success:
            add_log(operation_id, "✅ Build completed!")
            complete_operation(operation_id, True, "✅ Build completed")
        else:
            complete_operation(operation_id, True, "⚠️ Build finished")
            
    except Exception as e:
        add_log(operation_id, f"❌ Exception: {str(e)}")
        complete_operation(operation_id, False, f"❌ {str(e)}")


# =====================================================
# CLEAR CACHE
# =====================================================

@frappe.whitelist()
def run_clear_cache():
    """Clear all caches"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    
    try:
        frappe.clear_cache()
        
        try:
            frappe.cache().flushall()
        except:
            pass
        
        subprocess.run(
            ["bench", "clear-cache"],
            cwd=CONFIG["bench_path"],
            capture_output=True,
            timeout=30
        )
        
        try:
            frappe.clear_website_cache()
        except:
            pass
        
        return {"success": True, "message": _("✅ Cache cleared!")}
    except Exception as e:
        frappe.throw(f"❌ {str(e)}")


# =====================================================
# PROGRESS TRACKING
# =====================================================

@frappe.whitelist()
def get_operation_progress(operation_id):
    """Get progress from Redis"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    
    data = get_progress(operation_id)
    if data:
        return data
    
    return {"status": "not_found", "message": "Operation not found"}


@frappe.whitelist()
def get_all_operations():
    """Get all operations"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    
    # Can't easily list all from Redis, return empty
    return {}


@frappe.whitelist()
def clear_operation(operation_id):
    """Clear operation from cache"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    
    try:
        frappe.cache().delete_value(f"{CACHE_PREFIX}{operation_id}")
        return {"success": True}
    except:
        return {"success": False}


# =====================================================
# BENCH INFO
# =====================================================

@frappe.whitelist()
def get_bench_info():
    """Get bench info"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    
    supervisor_status = ""
    try:
        result = subprocess.run(
            ["supervisorctl", "status"],
            capture_output=True,
            text=True,
            timeout=5
        )
        supervisor_status = result.stdout
    except:
        supervisor_status = "Unable to get status"
    
    return {
        "bench_path": CONFIG["bench_path"],
        "bench_user": CONFIG["bench_user"],
        "site": CONFIG["site"],
        "supervisor_group": CONFIG["supervisor_group"],
        "supervisor_running": CONFIG["supervisor_group"] in supervisor_status,
        "systemd_setup": False,
        "frappe_version": frappe.__version__,
        "python_version": f"Python {sys.version.split()[0]}",
        "installed_apps": frappe.get_installed_apps(),
        "supervisor_status": supervisor_status
    }