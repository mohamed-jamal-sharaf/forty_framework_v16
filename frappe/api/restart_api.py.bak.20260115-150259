@frappe.whitelist()
def run_build(sudo_password=None, app=None):
    """Run bench build"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    
    operation_id = f"build_{int(time.time())}"
    
    try:
        init_operation(operation_id, "build")
        
        thread = threading.Thread(
            target=_do_build_safe,
            args=(operation_id, sudo_password, app),
            daemon=True
        )
        thread.start()
        
        return {"success": True, "operation_id": operation_id}
        
    except Exception as e:
        frappe.log_error(f"run_build error: {traceback.format_exc()}", "Bench Operations")
        frappe.throw(f"Failed to start build: {str(e)}")


def _do_build_safe(operation_id, sudo_password, app):
    """Wrapper to catch errors"""
    try:
        _do_build(operation_id, sudo_password, app)
    except Exception as e:
        frappe.log_error(f"Build thread error: {traceback.format_exc()}", "Bench Build Error")
        add_log(operation_id, f"❌ {str(e)}")
        complete_operation(operation_id, False, f"❌ {str(e)}")


def _do_build(operation_id, sudo_password, app):
    """Execute build in background"""
    bench_path = CONFIG["bench_path"]
    bench_user = CONFIG["bench_user"]
    
    build_cmd = "bench build"
    if app:
        build_cmd = f"bench build --app {app}"
        add_log(operation_id, f"🔨 Building: {app}")
    else:
        add_log(operation_id, "🔨 Building all apps...")
    
    update_progress(operation_id, 10, "Starting build...")
    
    if sudo_password:
        cmd = f"echo '{sudo_password}' | sudo -S -u {bench_user} bash -c 'cd {bench_path} && {build_cmd}' 2>&1"
    else:
        cmd = f"cd {bench_path} && {build_cmd} 2>&1"
    
    try:
        result = subprocess.run(
            cmd,
            shell=True,
            capture_output=True,
            text=True,
            timeout=600,
            cwd=bench_path
        )
        
        output = result.stdout or ""
        
        if output:
            lines = [l.strip() for l in output.split('\n') if l.strip()]
            for i, line in enumerate(lines):
                if 'password' not in line.lower():
                    add_log(operation_id, line)
                    progress = 10 + int(80 * (i + 1) / max(len(lines), 1))
                    update_progress(operation_id, min(progress, 90), line[:60])
        
        if result.returncode == 0:
            add_log(operation_id, "✅ Build completed!")
            complete_operation(operation_id, True, "✅ Build completed")
        else:
            complete_operation(operation_id, True, "⚠️ Build finished")
            
    except subprocess.TimeoutExpired:
        add_log(operation_id, "⏱️ Build timed out")
        complete_operation(operation_id, False, "❌ Timeout")
    except Exception as e:
        add_log(operation_id, f"❌ {str(e)}")
        complete_operation(operation_id, False, f"❌ {str(e)}")


