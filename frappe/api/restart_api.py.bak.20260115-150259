CACHE_PREFIX = "bench_operation_"


def get_progress(operation_id):
    """Get operation progress from Redis cache"""
    try:
        data = frappe.cache().get_value(f"{CACHE_PREFIX}{operation_id}")
        if data:
            if isinstance(data, str):
                return json.loads(data)
            return data
    except Exception as e:
        frappe.log_error(f"get_progress error: {e}", "Bench Operations")
    return None


def set_progress(operation_id, data):
    """Set operation progress in Redis cache"""
    try:
        frappe.cache().set_value(
            f"{CACHE_PREFIX}{operation_id}",
            json.dumps(data) if isinstance(data, dict) else data,
            expires_in_sec=3600
        )
    except Exception as e:
        frappe.log_error(f"set_progress error: {e}", "Bench Operations")


def add_log(operation_id, message):
    """Add a log entry"""
    try:
        data = get_progress(operation_id)
        if data:
            timestamp = get_datetime_str(now_datetime())
            data["logs"].append({
                "time": timestamp,
                "message": str(message)
            })
            data["message"] = str(message)[:100]
            set_progress(operation_id, data)
    except Exception as e:
        frappe.log_error(f"add_log error: {e}", "Bench Operations")


def update_progress(operation_id, progress, message):
    """Update progress"""
    try:
        data = get_progress(operation_id)
        if data:
            data["progress"] = progress
            data["message"] = str(message)[:100]
            set_progress(operation_id, data)
    except Exception as e:
        frappe.log_error(f"update_progress error: {e}", "Bench Operations")


def complete_operation(operation_id, success=True, message=""):
    """Mark operation complete"""
    try:
        data = get_progress(operation_id)
        if data:
            data["status"] = "completed" if success else "error"
            data["progress"] = 100
            data["message"] = message
            data["completed_at"] = get_datetime_str(now_datetime())
            set_progress(operation_id, data)
    except Exception as e:
        frappe.log_error(f"complete_operation error: {e}", "Bench Operations")


def init_operation(operation_id, operation_type):
    """Initialize a new operation"""
    data = {
        "operation": operation_type,
        "status": "running",
        "progress": 5,
        "message": "Initializing...",
        "started_at": get_datetime_str(now_datetime()),
        "logs": []
    }
    set_progress(operation_id, data)
    return data


# =====================================================
# MIGRATE
# =====================================================

@frappe.whitelist()
def run_migrate(sudo_password=None):
    """Run bench migrate"""
    if frappe.session.user != "Administrator":
        frappe.throw(_("🚫 Access Denied"))
    
    operation_id = f"migrate_{int(time.time())}"
    
    try:
        # Initialize operation in Redis
        init_operation(operation_id, "migrate")
        
        # Log that we received the request
        add_log(operation_id, "📦 Migration request received")
        add_log(operation_id, f"Password provided: {'Yes' if sudo_password else 'No'}")
        
        # Start background thread
        thread = threading.Thread(
            target=_do_migrate_safe,
            args=(operation_id, sudo_password),
            daemon=True
        )
        thread.start()
        
        # Give thread a moment to start
        time.sleep(0.5)
        
        return {"success": True, "operation_id": operation_id}
        
    except Exception as e:
        frappe.log_error(f"run_migrate error: {traceback.format_exc()}", "Bench Operations")
        frappe.throw(f"Failed to start migration: {str(e)}")


def _do_migrate_safe(operation_id, sudo_password):
    """Wrapper to catch all errors in thread"""
    try:
        _do_migrate(operation_id, sudo_password)
    except Exception as e:
        error_msg = f"Thread error: {str(e)}\n{traceback.format_exc()}"
        frappe.log_error(error_msg, "Bench Migrate Error")
        add_log(operation_id, f"❌ {str(e)}")
        complete_operation(operation_id, False, f"❌ {str(e)}")


def _do_migrate(operation_id, sudo_password):
    """Execute migrate in background"""
    site = CONFIG["site"]
    bench_path = CONFIG["bench_path"]
    bench_user = CONFIG["bench_user"]
    
    add_log(operation_id, f"📦 Starting migration for: {site}")
    update_progress(operation_id, 10, "Preparing migration...")
    
    add_log(operation_id, f"📁 Bench path: {bench_path}")
    add_log(operation_id, f"👤 Bench user: {bench_user}")
    update_progress(operation_id, 15, "Running migrations...")
    
    # Build the command - run as frappe user
    if sudo_password:
        cmd = f"echo '{sudo_password}' | sudo -S -u {bench_user} bash -c 'cd {bench_path} && bench --site {site} migrate' 2>&1"
    else:
        cmd = f"cd {bench_path} && bench --site {site} migrate 2>&1"
    
    add_log(operation_id, "🔄 Executing bench migrate...")
    update_progress(operation_id, 20, "Executing migrate...")
    
    try:
        result = subprocess.run(
            cmd,
            shell=True,
            capture_output=True,
            text=True,
            timeout=600,
            env={
                **os.environ,
                "PYTHONUNBUFFERED": "1",
                "HOME": f"/home/{bench_user}",
                "USER": bench_user,
                "PATH": f"/home/{bench_user}/.local/bin:/usr/local/bin:/usr/bin:/bin"
            }
        )
        
        # Process output
        output = result.stdout or ""
        stderr = result.stderr or ""
        
        if output:
            lines = [l.strip() for l in output.split('\n') if l.strip()]
            total = len(lines) if lines else 1
            for i, line in enumerate(lines):
                if 'password' not in line.lower():
                    add_log(operation_id, line)
                    progress = 20 + int(70 * (i + 1) / total)
                    update_progress(operation_id, min(progress, 90), line[:60])
        
        if stderr:
            for line in stderr.split('\n'):
                line = line.strip()
                if line and 'password' not in line.lower() and 'pkg_resources' not in line.lower():
                    add_log(operation_id, f"⚠️ {line}")
        
        # Check result
        if result.returncode == 0:
            add_log(operation_id, "✅ Migration completed successfully!")
            complete_operation(operation_id, True, "✅ Migration completed")
        elif "Updating" in output or "Syncing" in output or "Migrating" in output:
            add_log(operation_id, "✅ Migration completed!")
            complete_operation(operation_id, True, "✅ Migration completed")
        else:
            add_log(operation_id, f"⚠️ Exit code: {result.returncode}")
            if "sudo" in stderr.lower() or "password" in stderr.lower():
                add_log(operation_id, "❌ Sudo authentication failed")
                complete_operation(operation_id, False, "❌ Invalid sudo password")
            else:
                complete_operation(operation_id, True, "⚠️ Check logs")
                
    except subprocess.TimeoutExpired:
        add_log(operation_id, "⏱️ Migration timed out (10 min)")
        complete_operation(operation_id, False, "❌ Timeout")
    except Exception as e:
        add_log(operation_id, f"❌ Subprocess error: {str(e)}")
        complete_operation(operation_id, False, f"❌ {str(e)}")


