frappe.ui.form.on('Job Application Dashboard', {
    refresh: function(frm) {
        // Initialize the dashboard
        frm.trigger('init_dashboard');
        
        // Add custom buttons
        frm.add_custom_button(__('Refresh Dashboard'), function() {
            frappe.show_alert({message: 'Refreshing dashboard...', indicator: 'blue'});
            frm.trigger('load_dashboard');
        });
        
        frm.add_custom_button(__('Export Data'), function() {
            frm.trigger('export_dashboard_data');
        });
    },
    
    onload: function(frm) {
        // Initialize date filters if not set
        if (!frm.doc.from_date) {
            frm.set_value('from_date', frappe.datetime.add_months(frappe.datetime.get_today(), -1));
        }
        if (!frm.doc.to_date) {
            frm.set_value('to_date', frappe.datetime.get_today());
        }
    },
    
    init_dashboard: function(frm) {
        // Clear the HTML field
        $(frm.fields_dict.dashboard_html.wrapper).empty();
        
        // Create main container
        frm.dashboard_container = $(`
            <div class="job-application-dashboard">
                <div class="text-center" style="padding: 50px;">
                    <i class="fa fa-spinner fa-spin" style="font-size: 30px; color: #5e64ff;"></i>
                    <p style="margin-top: 10px; color: #6c757d;">Loading dashboard data...</p>
                </div>
            </div>
        `).appendTo(frm.fields_dict.dashboard_html.wrapper);
        
        // Load the dashboard data
        frm.trigger('load_dashboard');
    },
    
    from_date: function(frm) {
        frm.trigger('load_dashboard');
    },
    
    to_date: function(frm) {
        frm.trigger('load_dashboard');
    },
    
    load_dashboard: function(frm) {
        // Build filters
        const filters = {};
        if (frm.doc.from_date && frm.doc.to_date) {
            filters.creation = ['between', [frm.doc.from_date, frm.doc.to_date]];
        }
        
        // Fetch data
        frappe.call({
            method: 'frappe.client.get_list',
            args: {
                doctype: 'Job Application Form',
                fields: ['*'],
                filters: filters,
                limit_page_length: 5000
            },
            callback: function(r) {
                if (r.message && r.message.length > 0) {
                    // Process and render dashboard
                    const applications = r.message;
                    const stats = calculateStatistics(applications);
                    renderDashboard(frm, applications, stats);
                } else {
                    // Show empty state
                    frm.dashboard_container.html(`
                        <div class="text-center" style="padding: 50px;">
                            <i class="fa fa-inbox" style="font-size: 50px; color: #6c757d;"></i>
                            <p style="margin-top: 10px; color: #6c757d;">No applications found for the selected period.</p>
                        </div>
                    `);
                }
            },
            error: function(err) {
                console.error('Dashboard Error:', err);
                frm.dashboard_container.html(`
                    <div class="text-center" style="padding: 50px;">
                        <i class="fa fa-exclamation-triangle" style="font-size: 50px; color: #dc3545;"></i>
                        <p style="margin-top: 10px; color: #dc3545;">Error loading dashboard data.</p>
                        <p style="color: #6c757d;">${err.message || 'Please try again later.'}</p>
                    </div>
                `);
            }
        });
    },
    
    export_dashboard_data: function(frm) {
        frappe.call({
            method: 'frappe.client.get_list',
            args: {
                doctype: 'Job Application Form',
                fields: ['*'],
                limit_page_length: 5000
            },
            callback: function(r) {
                if (r.message && r.message.length > 0) {
                    downloadCSV(r.message);
                    frappe.show_alert({
                        message: 'Data exported successfully!',
                        indicator: 'green'
                    });
                } else {
                    frappe.show_alert({
                        message: 'No data to export',
                        indicator: 'orange'
                    });
                }
            }
        });
    }
});

// Helper function to calculate statistics
function calculateStatistics(applications) {
    const stats = {
        total: applications.length,
        thisMonth: 0,
        avgExperience: 0,
        willingToRelocate: 0,
        departments: {},
        positions: {},
        employmentTypes: {},
        availability: {},
        education: {},
        experienceRanges: {
            '0-2 years': 0,
            '3-5 years': 0,
            '6-10 years': 0,
            '10+ years': 0
        }
    };
    
    const currentMonth = new Date().getMonth();
    const currentYear = new Date().getFullYear();
    let totalExperience = 0;
    let relocateCount = 0;
    
    applications.forEach(app => {
        // Monthly count
        const appDate = new Date(app.creation);
        if (appDate.getMonth() === currentMonth && appDate.getFullYear() === currentYear) {
            stats.thisMonth++;
        }
        
        // Department distribution
        if (app.department) {
            stats.departments[app.department] = (stats.departments[app.department] || 0) + 1;
        }
        
        // Position distribution
        if (app.job_position) {
            stats.positions[app.job_position] = (stats.positions[app.job_position] || 0) + 1;
        }
        
        // Employment type
        if (app.employment_type) {
            stats.employmentTypes[app.employment_type] = (stats.employmentTypes[app.employment_type] || 0) + 1;
        }
        
        // Availability
        if (app.availability) {
            stats.availability[app.availability] = (stats.availability[app.availability] || 0) + 1;
        }
        
        // Education
        if (app.highest_degree) {
            stats.education[app.highest_degree] = (stats.education[app.highest_degree] || 0) + 1;
        }
        
        // Experience
        if (app.years_of_experience !== undefined && app.years_of_experience !== null) {
            const exp = parseInt(app.years_of_experience) || 0;
            totalExperience += exp;
            
            if (exp <= 2) {
                stats.experienceRanges['0-2 years']++;
            } else if (exp <= 5) {
                stats.experienceRanges['3-5 years']++;
            } else if (exp <= 10) {
                stats.experienceRanges['6-10 years']++;
            } else {
                stats.experienceRanges['10+ years']++;
            }
        }
        
        // Relocation
        if (app.are_you_willing_to_relocate_for_projects === 'Yes') {
            relocateCount++;
        }
    });
    
    stats.avgExperience = applications.length > 0 ? totalExperience / applications.length : 0;
    stats.willingToRelocate = applications.length > 0 ? Math.round((relocateCount / applications.length) * 100) : 0;
    
    return stats;
}

