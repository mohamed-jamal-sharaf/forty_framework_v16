// Generate table rows
function generateTableRows(applications) {
    const recent = applications
        .sort((a, b) => new Date(b.creation) - new Date(a.creation))
        .slice(0, 15);
    
    return recent.map(app => `
        <tr>
            <td>
                <div><strong>${app.full_name || 'N/A'}</strong></div>
                <small class="text-muted">${app.email || ''}</small>
            </td>
            <td>${app.job_position || 'N/A'}</td>
            <td>
                <span class="badge badge-primary" style="background: #5470c6;">
                    ${app.department || 'N/A'}
                </span>
            </td>
            <td>${app.years_of_experience || 0} years</td>
            <td>${app.highest_degree || 'N/A'}</td>
            <td>${app.expected_salary ? frappe.format(app.expected_salary, {fieldtype: 'Currency'}) : 'Not specified'}</td>
            <td>${frappe.datetime.str_to_user(app.creation)}</td>
        </tr>
    `).join('');
}

// Render all charts
function renderCharts(stats) {
    // Department Chart
    const deptData = Object.entries(stats.departments)
        .map(([name, value]) => ({ name, value }))
        .sort((a, b) => b.value - a.value)
        .slice(0, 10);
    
    if (deptData.length > 0 && $('#department-chart').length) {
        new frappe.Chart('#department-chart', {
            data: {
                labels: deptData.map(d => d.name),
                datasets: [{
                    values: deptData.map(d => d.value)
                }]
            },
            type: 'pie',
            height: 280,
            colors: ['#5470c6', '#91cc75', '#fac858', '#ee6666', '#73c0de', '#3ba272', '#fc8452', '#9a60b4', '#ea7ccc']
        });
    }
    
    // Position Chart
    const positionData = Object.entries(stats.positions)
        .map(([name, value]) => ({ name, value }))
        .sort((a, b) => b.value - a.value)
        .slice(0, 10);
    
    if (positionData.length > 0 && $('#position-chart').length) {
        new frappe.Chart('#position-chart', {
            data: {
                labels: positionData.map(d => d.name.substring(0, 20) + (d.name.length > 20 ? '...' : '')),
                datasets: [{
                    values: positionData.map(d => d.value)
                }]
            },
            type: 'bar',
            height: 280,
            colors: ['#5470c6']
        });
    }
    
    // Employment Type Chart
    const empData = Object.entries(stats.employmentTypes)
        .map(([name, value]) => ({ name, value }));
    
    if (empData.length > 0 && $('#employment-type-chart').length) {
        new frappe.Chart('#employment-type-chart', {
            data: {
                labels: empData.map(d => d.name),
                datasets: [{
                    values: empData.map(d => d.value)
                }]
            },
            type: 'donut',
            height: 230,
            colors: ['#667eea', '#764ba2', '#f093fb', '#f5576c']
        });
    }
    
    // Availability Chart
    const availData = Object.entries(stats.availability)
        .map(([name, value]) => ({ name, value }));
    
    if (availData.length > 0 && $('#availability-chart').length) {
        new frappe.Chart('#availability-chart', {
            data: {
                labels: availData.map(d => d.name),
                datasets: [{
                    values: availData.map(d => d.value)
                }]
            },
            type: 'percentage',
            height: 230,
            colors: ['#4facfe', '#00f2fe', '#43e97b', '#38f9d7']
        });
    }
    
    // Education Chart
    const eduData = Object.entries(stats.education)
        .map(([name, value]) => ({ name, value }));
    
    if (eduData.length > 0 && $('#education-chart').length) {
        new frappe.Chart('#education-chart', {
            data: {
                labels: eduData.map(d => d.name),
                datasets: [{
                    values: eduData.map(d => d.value)
                }]
            },
            type: 'percentage',
            height: 230,
            colors: ['#fa709a', '#fee140', '#30cfd0', '#a8edea']
        });
    }
    
    // Experience Chart
    const expData = Object.entries(stats.experienceRanges)
        .map(([name, value]) => ({ name, value }));
    
    if (expData.length > 0 && $('#experience-chart').length) {
        new frappe.Chart('#experience-chart', {
            data: {
                labels: expData.map(d => d.name),
                datasets: [{
                    name: 'Candidates',
                    values: expData.map(d => d.value)
                }]
            },
            type: 'bar',
            height: 230,
            colors: ['#667eea'],
            axisOptions: {
                xAxisMode: 'tick'
            }
        });
    }
}

// Setup event listeners
function setupEventListeners() {
    // Table search functionality
    $('#table-search').off('keyup').on('keyup', function() {
        const searchTerm = $(this).val().toLowerCase();
        $('#applications-table tbody tr').each(function() {
            const text = $(this).text().toLowerCase();
            $(this).toggle(text.includes(searchTerm));
        });
    });
}

// Export to CSV helper
function downloadCSV(applications) {
    // Prepare CSV headers
    const headers = [
        'Full Name',
        'Email',
        'Phone',
        'Position',
        'Department',
        'Years of Experience',
        'Education',
        'Expected Salary',
        'Current Salary',
        'Nationality',
        'Country',
        'City',
        'Willing to Relocate',
        'Available to Join',
        'Application Date'
    ];
    
    // Prepare CSV rows
    const rows = applications.map(app => [
        app.full_name || '',
        app.email || '',
        app.phone_number || '',
        app.job_position || '',
        app.department || '',
        app.years_of_experience || '0',
        app.highest_degree || '',
        app.expected_salary || '',
        app.current_salary || '',
        app.nationality || '',
        app.country || '',
        app.city || '',
        app.are_you_willing_to_relocate_for_projects || '',
        app.availability || '',
        frappe.datetime.str_to_user(app.creation)
    ]);
    
    // Convert to CSV format
    const csvContent = [
        headers.join(','),
        ...rows.map(row => row.map(cell => `"${cell}"`).join(','))
    ].join('\n');
    
    // Create download
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `job_applications_${frappe.datetime.nowdate()}.csv`;
    link.click();
}