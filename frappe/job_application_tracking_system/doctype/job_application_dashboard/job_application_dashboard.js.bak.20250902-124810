        'Full Name', 'Email', 'Phone', 'Position', 'Department', 
        'Years of Experience', 'Education', 'Expected Salary', 
        'Current Salary', 'Nationality', 'Country', 'City',
        'Willing to Relocate', 'Application Date'
    ];
    
    const rows = applications.map(app => [
        app.full_name || '',
        app.email || '',
        app.phone_number || '',
        app.job_position || '',
        app.department || '',
        app.years_of_experience || 0,
        app.highest_degree || '',
        app.expected_salary || '',
        app.current_salary || '',
        app.nationality || '',
        app.country || '',
        app.city || '',
        app.are_you_willing_to_relocate_for_projects || '',
        new Date(app.creation).toLocaleDateString()
    ]);
    
    const csvContent = [
        headers.join(','),
        ...rows.map(row => row.map(cell => `"${cell}"`).join(','))
    ].join('\n');
    
    return csvContent;
}

function downloadCSV(csv, filename) {
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.setAttribute('hidden', '');
    a.setAttribute('href', url);
    a.setAttribute('download', filename);
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
}