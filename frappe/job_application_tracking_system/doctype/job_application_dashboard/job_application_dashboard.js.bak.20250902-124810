        .slice(0, 20); // Show more records
    
    return recent.map(app => `
        <tr style="transition: background 0.2s;" onmouseover="this.style.background='#f8f9fa'" onmouseout="this.style.background='white'">
            <td style="padding: 12px; border-bottom: 1px solid #dee2e6;">
                <div style="font-weight: 500;">${app.full_name || 'N/A'}</div>
                <small style="color: #666;">${app.email || ''}</small>
            </td>
            <td style="padding: 12px; border-bottom: 1px solid #dee2e6;">${app.job_position || 'N/A'}</td>
            <td style="padding: 12px; border-bottom: 1px solid #dee2e6;">
                <span style="background: #e3f2fd; color: #1976d2; padding: 4px 8px; border-radius: 4px; font-size: 12px;">
                    ${app.department || 'N/A'}
                </span>
            </td>
            <td style="padding: 12px; border-bottom: 1px solid #dee2e6;">${app.years_of_experience || 0} years</td>
            <td style="padding: 12px; border-bottom: 1px solid #dee2e6;">${app.highest_degree || 'N/A'}</td>
            <td style="padding: 12px; border-bottom: 1px solid #dee2e6;">
                ${app.expected_salary ? '$' + app.expected_salary.toLocaleString() : 'Not specified'}
            </td>
            <td style="padding: 12px; border-bottom: 1px solid #dee2e6;">${new Date(app.creation).toLocaleDateString()}</td>
        </tr>
    `).join('');
}

