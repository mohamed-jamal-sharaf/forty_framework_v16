function calculateEnhancedStatistics(applications) {
    const stats = {
        total: applications.length,
        thisMonth: 0,
        lastMonth: 0,
        monthGrowth: 0,
        avgExperience: 0,
        avgExpectedSalary: 0,
        willingToRelocate: 0,
        saudconsultStaff: 0,
        departments: {},
        positions: {},
        employmentTypes: {},
        availability: {},
        education: {},
        countries: {},
        nationalities: {},
        salaryByDepartment: {},
        timeline: {},
        experienceRanges: {
            '0-2 years': 0,
            '3-5 years': 0,
            '6-10 years': 0,
            '10+ years': 0
        }
    };
    
    const currentDate = new Date();
    const currentMonth = currentDate.getMonth();
    const currentYear = currentDate.getFullYear();
    const lastMonthDate = new Date(currentYear, currentMonth - 1, 1);
    
    let totalExperience = 0;
    let totalExpectedSalary = 0;
    let salaryCount = 0;
    let relocateCount = 0;
    
    applications.forEach(app => {
        const appDate = new Date(app.creation);
        
        // Monthly statistics
        if (appDate.getMonth() === currentMonth && appDate.getFullYear() === currentYear) {
            stats.thisMonth++;
        }
        if (appDate.getMonth() === lastMonthDate.getMonth() && appDate.getFullYear() === lastMonthDate.getFullYear()) {
            stats.lastMonth++;
        }
        
        // Timeline data (daily)
        const dateKey = appDate.toISOString().split('T')[0];
        stats.timeline[dateKey] = (stats.timeline[dateKey] || 0) + 1;
        
        // SAUDCONSULT Staff
        if (app.saudconsult_staff) {
            stats.saudconsultStaff++;
        }
        
        // Department distribution
        if (app.department) {
            stats.departments[app.department] = (stats.departments[app.department] || 0) + 1;
            
            // Salary by department
            if (app.expected_salary) {
                if (!stats.salaryByDepartment[app.department]) {
                    stats.salaryByDepartment[app.department] = { total: 0, count: 0 };
                }
                stats.salaryByDepartment[app.department].total += app.expected_salary;
                stats.salaryByDepartment[app.department].count++;
            }
        }
        
        // Position distribution
        if (app.job_position) {
            stats.positions[app.job_position] = (stats.positions[app.job_position] || 0) + 1;
        }
        
        // Geographic data
        if (app.country) {
            stats.countries[app.country] = (stats.countries[app.country] || 0) + 1;
        }
        if (app.nationality) {
            stats.nationalities[app.nationality] = (stats.nationalities[app.nationality] || 0) + 1;
        }
        
        // Employment type
        if (app.employment_type) {
            stats.employmentTypes[app.employment_type] = (stats.employmentTypes[app.employment_type] || 0) + 1;
        }
        
        // Availability
        if (app.availability) {
            stats.availability[app.availability] = (stats.availability[app.availability] || 0) + 1;
        }
        
        // Education
        if (app.highest_degree) {
            stats.education[app.highest_degree] = (stats.education[app.highest_degree] || 0) + 1;
        }
        
        // Experience
        if (app.years_of_experience) {
            totalExperience += app.years_of_experience;
            
            if (app.years_of_experience <= 2) {
                stats.experienceRanges['0-2 years']++;
            } else if (app.years_of_experience <= 5) {
                stats.experienceRanges['3-5 years']++;
            } else if (app.years_of_experience <= 10) {
                stats.experienceRanges['6-10 years']++;
            } else {
                stats.experienceRanges['10+ years']++;
            }
        }
        
        // Expected salary
        if (app.expected_salary) {
            totalExpectedSalary += app.expected_salary;
            salaryCount++;
        }
        
        // Relocation willingness
        if (app.are_you_willing_to_relocate_for_projects === 'Yes') {
            relocateCount++;
        }
    });
    
    // Calculate averages and growth
    stats.avgExperience = applications.length > 0 ? totalExperience / applications.length : 0;
    stats.avgExpectedSalary = salaryCount > 0 ? Math.round(totalExpectedSalary / salaryCount) : 0;
    stats.willingToRelocate = applications.length > 0 ? Math.round((relocateCount / applications.length) * 100) : 0;
    
    if (stats.lastMonth > 0) {
        stats.monthGrowth = Math.round(((stats.thisMonth - stats.lastMonth) / stats.lastMonth) * 100);
    }
    
    return stats;
}

